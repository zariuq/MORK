(def (add_c $a) (, (state fd $b)) (O (+ (constant $a fd $b))))
(def (add_v $a) (, (state fd $b)) (O (+ (variable $a frame $b))))
(def pop-frame (, (state fd $a) (S $b $a)) (O (+ (state fd $b)) (- (state fd $a))))
(def push-frame (, (state fd $a) (S $a $b)) (O (+ (state fd $b)) (- (state fd $a))))
