;; Note, we will be linking in comments the HE MeTTa functions that are replaced by MM2 ones.

(S 0 1)
(S 1 2)
(S 2 3)

(state fd 0)

; (= (push-frame $fd)
;   (adjust-state-additive $fd 1))
(def push-frame
  (, (state fd $a) (S $a $b))
  (O (+ (state fd $b))
     (- (state fd $a))))

;; (push-frame &fd)
(step (0 push-frame))

(exec bc
  (, (def $name $premises $conclusions) (step ($priority $name)) (exec bc $p $c))
  (O (+ (exec ($priority $name) $premises $conclusions))
     (- (step ($priority $name)))
     (+ (exec bc $p $c))))

