; ACT Query Demo - Reading from fruit_colors.act
; ===============================================
;
; Prerequisites:
; Create the ACT file first:
;   ./examples/misc/make_fruit_colors_act.sh
;
; Or see CREATE_ACT_FILES.md for other methods

; Query 1: Find what color an apple is
; Pattern: (ACT <filename> <pattern>) matches expressions in the ACT file
(exec (0 find-apple-color)
  (I (ACT fruit_colors (color apple $color)))
  (O (+ (result apple-is $color))))

; Query 2: Find all yellow fruits
(exec (0 find-yellow-fruits)
  (I (ACT fruit_colors (color $fruit yellow)))
  (O (+ (yellow-fruit $fruit))))

; Query 3: Multiple ACT queries in conjunction - NOT WORKING YET
; This pattern doesn't work in current MORK implementation
; See act_demo_same_color.mm2 for the working two-stage approach!
;
; (exec (0 find-same-color-fruits)
;   (, (ACT fruit_colors (color $fruit1 $c))
;      (ACT fruit_colors (color $fruit2 $c)))
;   (O (+ (same-color $fruit1 $fruit2 $c))))
;
; Limitation: Multiple ACT sources in conjunction don't fire
; Workaround: Use two-stage approach (fetch to space, then cross-match)
; See: act_demo_same_color.mm2 for working example
