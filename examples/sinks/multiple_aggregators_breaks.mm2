;; out: (count 3)
(exec (0 just-count)
  (, (item $x))
  (O (count (count $k) $k (item $x))))

;; out:
;; (count-item2 4)
;; (count-item2.2 4)
(exec (5 two-counts-same-var)
  (, (item2 $x))
  (O (count (count-item2 $k) $k $x)
     (count (count-item2.2 $k) $k $x)))

;; out: 
