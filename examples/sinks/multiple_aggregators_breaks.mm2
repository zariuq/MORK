;; (count-item2-vv-n (count-item2-vv-n $a))
(exec (5 two-counts-diff-var-value)
  (, (item $x) (item2 $y))
  (O (count (count-item-vv-k $k) $k $x)
     (count (count-item2-vv-n $n) $n $y)))

; === Test 2: Duplicates - MAX and COUNT with SAME variable ===
(dup-data 1 7)
(dup-data 2 3)
(dup-data 3 7)
(dup-data 4 9)
(dup-data 5 7)

(exec (2 test-duplicates)
  (, (dup-data $c $v))
  (O (max (max-of-dups $m) $m $v)
     (min (min-of-dups $m) $m $v)
     (count (count-dups $m) $m ($c $v))
     (count (count-dups-unique $m) $m $v)
     (head 3 (head-dups $c $v))))
    ;  (+ (love $m)))) ;; (love $a) 

;; head with $v only breaks -- probably due to the duplicates becoming unique.
;; So we CAN use multiple sinks in one exec -- they just need to use the same variable, even though they'll have different values.
