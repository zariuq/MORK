; Test: MIN sink with variable guard
; ===================================
;
; Demonstrates: (O (min <report($m)> $m <value>))
; The $m variable gets substituted with the computed minimum

; Data: Various numeric values
(depth frame-1 3)
(depth frame-2 7)
(depth frame-3 2)
(depth frame-4 9)
(depth frame-5 5)

; Exec: Find minimum depth
(exec 0
  (, (depth $frame $level))
  (O (min (min-depth $m) $m $level)))

; Expected output:
; (min-depth 2)
;
; Explanation: MinSink collects all $level values (3, 7, 2, 9, 5),
; finds the minimum (2), and substitutes $m in the report template
