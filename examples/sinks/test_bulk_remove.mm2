; Test: Bulk remove by pattern
; =============================
;
; Demonstrates: Removing multiple facts that match a pattern
; Based on test from kernel/src/main.rs:1397

; Setup: Facts to keep and facts to remove
(row 1 2 3)
(col 3 4 5)
(keep-this)

; Mark what to remove (use concrete facts, not patterns!)
(remove (col 3 4 5))
(remove (row 1 2 3))

; Test: Remove all marked facts
(exec 0
  (, (remove $x) $x)
  (O (- $x)
     (- (remove $x))))

; Expected output:
; (keep-this)
;
; How it works:
; 1. Pattern matches: (remove (col ...)) with $x = (col 3 4 5)
; 2. Pattern matches: (remove (row ...)) with $x = (row 1 2 3)
; 3. Both are removed by (- $x)
;
; This is a "mark and sweep" pattern for bulk deletion.
