; Test: ADD constant (no variables)
; =================================
;
; Demonstrates: (O (+ <constant>)) to add a constant fact
; Based on test from kernel/src/main.rs:1342

; Setup
(trigger-ready)

; Test: Add a constant symbol
(exec 0
  (, (trigger-ready))
  (O (+ MATCHED)
     (- (trigger-ready))))

; Expected output:
; MATCHED
;
; The symbol MATCHED is added without any variables.
; This is the simplest form of ADD - just a constant symbol.
