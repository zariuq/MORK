; Test: Complex report template with arity > 2
; Can we break the "append only" approach?

(edge a b 5)
(edge a c 7)
(edge a d 9)
(src a)

(exec 0
  (, (src $s) (edge $s $t $weight))
  (O (max (best-path $m from $s to $t) $m $weight)))

; Expected: (best-path 9 from a to d)
; But will our "append only" approach work?
