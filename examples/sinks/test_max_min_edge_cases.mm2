; Test: MaxSink/MinSink Edge Cases
; ==================================
;
; Tests critical edge cases for max/min sinks:
; - Empty result sets
; - Single values
; - All duplicates
; - Negative numbers
; - Boundary values

; ========================================
; TEST 1: Empty Result Set
; ========================================
; Query that matches nothing
(exec 0
  (, (non-existent $x))
  (O (max (empty-max $m) $m $x)))

; Expected: NO OUTPUT (silent failure is correct)

; ========================================
; TEST 2: Single Value
; ========================================
(single-val 42)

(exec 1
  (, (single-val $v))
  (O (max (single-max $m) $m $v)))

(exec 2
  (, (single-val $v))
  (O (min (single-min $m) $m $v)))

; Expected:
; (single-max 42)
; (single-min 42)

; ========================================
; TEST 3: All Duplicate Values
; ========================================
(dup 7) (dup 7) (dup 7) (dup 7) (dup 7)

(exec 3
  (, (dup $v))
  (O (max (dup-max $m) $m $v)))

(exec 4
  (, (dup $v))
  (O (min (dup-min $m) $m $v)))

; Expected:
; (dup-max 7)
; (dup-min 7)

; ========================================
; TEST 4: Negative Numbers Only
; ========================================
(neg-val -5)
(neg-val -10)
(neg-val -2)
(neg-val -8)
(neg-val -1)

(exec 5
  (, (neg-val $v))
  (O (max (neg-max $m) $m $v)))

(exec 6
  (, (neg-val $v))
  (O (min (neg-min $m) $m $v)))

; Expected:
; (neg-max -1)  ; -1 is the maximum of negative numbers
; (neg-min -10) ; -10 is the minimum

; ========================================
; TEST 5: Mix of Negative and Positive
; ========================================
(mixed -15)
(mixed -5)
(mixed 0)
(mixed 5)
(mixed 15)

(exec 7
  (, (mixed $v))
  (O (max (mixed-max $m) $m $v)))

(exec 8
  (, (mixed $v))
  (O (min (mixed-min $m) $m $v)))

; Expected:
; (mixed-max 15)
; (mixed-min -15)

; ========================================
; TEST 6: Zero as Max/Min
; ========================================
(zero-test -3)
(zero-test -1)
(zero-test 0)

(exec 9
  (, (zero-test $v))
  (O (max (zero-max $m) $m $v)))

(zero-test2 0)
(zero-test2 1)
(zero-test2 3)

(exec 10
  (, (zero-test2 $v))
  (O (min (zero-min $m) $m $v)))

; Expected:
; (zero-max 0)  ; 0 is maximum of {-3, -1, 0}
; (zero-min 0)  ; 0 is minimum of {0, 1, 3}

; ========================================
; TEST 7: Large Numbers (i64 boundaries)
; ========================================
; Near i64 max: 9223372036854775807
(large-val 9223372036854775806)
(large-val 9223372036854775807)
(large-val 9223372036854775805)

(exec 11
  (, (large-val $v))
  (O (max (large-max $m) $m $v)))

; Near i64 min: -9223372036854775808
(small-val -9223372036854775808)
(small-val -9223372036854775807)
(small-val -9223372036854775806)

(exec 12
  (, (small-val $v))
  (O (min (small-min $m) $m $v)))

; Expected:
; (large-max 9223372036854775807)
; (small-min -9223372036854775808)

; ========================================
; TEST 8: Two-Element Comparison
; ========================================
(pair 100)
(pair 99)

(exec 13
  (, (pair $v))
  (O (max (pair-max $m) $m $v)))

(exec 14
  (, (pair $v))
  (O (min (pair-min $m) $m $v)))

; Expected:
; (pair-max 100)
; (pair-min 99)

; ========================================
; SUMMARY OF EXPECTED OUTPUT:
; ========================================
; No output from TEST 1 (empty set)
; (single-max 42)
; (single-min 42)
; (dup-max 7)
; (dup-min 7)
; (neg-max -1)
; (neg-min -10)
; (mixed-max 15)
; (mixed-min -15)
; (zero-max 0)
; (zero-min 0)
; (large-max 9223372036854775807)
; (small-min -9223372036854775808)
; (pair-max 100)
; (pair-min 99)
