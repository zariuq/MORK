; Test: MaxSink/MinSink Type Error Handling
; ==========================================
;
; Tests how max/min handle non-numeric and malformed values
; Key behavior: Non-numeric values are SILENTLY SKIPPED

; ========================================
; TEST 1: Non-Numeric Symbols Only
; ========================================
(symbol-val apple)
(symbol-val banana)
(symbol-val cherry)

(exec 0
  (, (symbol-val $v))
  (O (max (symbol-max $m) $m $v)))

; Expected: NO OUTPUT (all values non-numeric, silently skipped)

; ========================================
; TEST 2: Mixed Numeric and Non-Numeric
; ========================================
(mixed-type 5)
(mixed-type apple)
(mixed-type 10)
(mixed-type banana)
(mixed-type 3)

(exec 1
  (, (mixed-type $v))
  (O (max (mixed-max $m) $m $v)))

(exec 2
  (, (mixed-type $v))
  (O (min (mixed-min $m) $m $v)))

; Expected:
; (mixed-max 10)  ; Non-numeric values silently skipped
; (mixed-min 3)

; ========================================
; TEST 3: Partial Numeric Strings
; ========================================
; CRITICAL BUG: "123abc" parses as 123!
(partial 123abc)
(partial 456def)
(partial 789)

(exec 3
  (, (partial $v))
  (O (max (partial-max $m) $m $v)))

; Expected:
; (partial-max 789)
; NOTE: If "123abc" parses as "123", max would be 789
; This tests current behavior, not necessarily correct behavior

; ========================================
; TEST 4: Non-Numeric Prefix
; ========================================
; Values starting with letters should be skipped
(prefix-test abc123)
(prefix-test def456)
(prefix-test 789)

(exec 4
  (, (prefix-test $v))
  (O (max (prefix-max $m) $m $v)))

; Expected:
; (prefix-max 789)  ; "abc123" and "def456" skipped

; ========================================
; TEST 5: Float-Like Strings
; ========================================
; CRITICAL BUG: "1.5" parses as "1" (stops at '.')
(float-like 1.5)
(float-like 3.14)
(float-like 2.7)
(float-like 10)

(exec 5
  (, (float-like $v))
  (O (max (float-max $m) $m $v)))

; Expected:
; (float-max 10)
; NOTE: "1.5" → 1, "3.14" → 3, "2.7" → 2, "10" → 10
; Max of {1, 3, 2, 10} = 10

; ========================================
; TEST 6: Scientific Notation
; ========================================
; "1e5" should mean 100000, but parses as "1" (stops at 'e')
(scientific 1e5)
(scientific 2e3)
(scientific 500)

(exec 6
  (, (scientific $v))
  (O (max (sci-max $m) $m $v)))

; Expected:
; (sci-max 500)
; NOTE: "1e5" → 1, "2e3" → 2, actual max = 500

; ========================================
; TEST 7: Special Characters
; ========================================
(special 100)
(special -50)
(special +75)  ; Leading plus sign
(special 200)

(exec 7
  (, (special $v))
  (O (max (special-max $m) $m $v)))

; Expected:
; (special-max 200) or possibly no output if "+75" fails to parse
; Tests handling of '+' prefix

; ========================================
; TEST 8: Empty/Whitespace-Like
; ========================================
; Testing edge cases with minimal content
(minimal 0)
(minimal 1)

(exec 8
  (, (minimal $v))
  (O (max (minimal-max $m) $m $v)))

; Expected:
; (minimal-max 1)

; ========================================
; TEST 9: Tuples as Values
; ========================================
; Values that are tuples, not atoms
(tuple-val (nested 5))
(tuple-val (nested 10))
(tuple-val 7)

(exec 9
  (, (tuple-val $v))
  (O (max (tuple-max $m) $m $v)))

; Expected:
; (tuple-max 7)  ; Tuples skipped, only 7 is atomic numeric

; ========================================
; TEST 10: Leading Zeros
; ========================================
(leading-zero 007)
(leading-zero 042)
(leading-zero 100)

(exec 10
  (, (leading-zero $v))
  (O (max (zero-prefix-max $m) $m $v)))

; Expected:
; (zero-prefix-max 100)
; NOTE: 007 → 7, 042 → 42, 100 → 100

; ========================================
; TEST 11: All Values Malformed
; ========================================
(all-bad apple)
(all-bad banana)
(all-bad (tuple stuff))

(exec 11
  (, (all-bad $v))
  (O (max (all-bad-max $m) $m $v)))

(exec 12
  (, (all-bad $v))
  (O (min (all-bad-min $m) $m $v)))

; Expected: NO OUTPUT from either (all values skipped)

; ========================================
; TEST 12: One Good, Rest Bad
; ========================================
(mostly-bad apple)
(mostly-bad banana)
(mostly-bad 42)
(mostly-bad cherry)

(exec 13
  (, (mostly-bad $v))
  (O (max (mostly-bad-max $m) $m $v)))

; Expected:
; (mostly-bad-max 42)  ; Only valid numeric value

; ========================================
; SUMMARY OF EXPECTED BEHAVIOR:
; ========================================
; - Non-numeric symbols: SILENTLY SKIPPED
; - Partial numerics: PARSES PREFIX (potential bug)
; - Float strings: PARSES INTEGER PREFIX (potential bug)
; - Scientific notation: PARSES PREFIX, NOT EXPONENT (bug)
; - All bad values: NO OUTPUT
; - Mixed good/bad: USES ONLY GOOD VALUES

