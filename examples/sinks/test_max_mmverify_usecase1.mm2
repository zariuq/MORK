; Test: MaxSink for finding max frame depth - USE CASE 1
; From mmverify-utils.metta line 333:
; ($e_max_level (if (== $e_levels (())) 0 (max-atom $e_levels)))
;
; In MORK/MM2 this would translate to:
; (exec 0
;   (, (level $l))
;   (O (max (max-level $m) $m $l)))

; Simulate collected frame levels from EList entries
(level 1)
(level 3)
(level 2)
(level 5)
(level 4)

(exec 0
  (, (level $l))
  (O (max (max-level $m) $m $l)))

; Expected: (max-level 5)
; This matches the mmverify use case where we find the maximum depth
; of the frame stack to process ehyps in order
