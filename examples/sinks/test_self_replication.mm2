; Test: Self-Replication Pattern - The Fundamental Iteration Pattern
;
; Self-replication is MORK's core iteration mechanism:
; An exec rule produces data that triggers ITSELF again
;
; This is THE fundamental pattern for:
; - Loops
; - Recursion
; - Iteration
; - State machines
; - Fractals

; ============================================================================
; EXAMPLE 1: Simple counter (self-replication with termination)
; ============================================================================

(count 0)

; Self-replicating rule: processes count and produces next count
(exec 0
  (, (count $n))
  (O (+ (count (+ $n 1)))
     (- (count $n))))

; This would run forever! But we only run 5 steps
; Expected: (count 0) → (count 1) → (count 2) → (count 3) → (count 4) → (count 5)

; ============================================================================
; EXAMPLE 2: Self-replication with guard (conditional termination)
; ============================================================================

(fib-state 0 0 1)

; Generate Fibonacci: state is (index, fib(n), fib(n+1))
; Only continue if index < 10
(exec 1
  (, (fib-state $n $a $b))
  (O (+ (fib $n is $a))
     (+ (fib-state (+ $n 1) $b (+ $a $b)))
     (- (fib-state $n $a $b))))

; Expected: Generates fib(0) through fib(9)
; Self-replicates until n reaches 10

; ============================================================================
; EXAMPLE 3: Fractal subdivision (Sierpiński pattern)
; ============================================================================

(segment 0 100 depth-0)

; Subdivide segments fractally
; Each segment spawns TWO child segments (midpoint subdivision)
(exec 2
  (, (segment $start $end depth-0))
  (O (+ (segment $start (/ (+ $start $end) 2) depth-1))
     (+ (segment (/ (+ $start $end) 2) $end depth-1))
     (- (segment $start $end depth-0))))

(exec 3
  (, (segment $start $end depth-1))
  (O (+ (segment $start (/ (+ $start $end) 2) depth-2))
     (+ (segment (/ (+ $start $end) 2) $end depth-2))
     (- (segment $start $end depth-1))))

; Expected: Fractal subdivision like Sierpiński triangle
; Each exec spawns 2 new segments at next depth level

; ============================================================================
; EXAMPLE 4: Self-replication with MAX (finding maximum in iteration)
; ============================================================================

(iterate 5 value 10)

; Self-replicating iteration that also tracks max value seen
(exec 4
  (, (iterate $n value $v))
  (O (max (max-during-iteration $m) $m $v)
     (+ (iterate (+ $n 1) value (* $v 2)))
     (- (iterate $n value $v))))

; Expected: Iterates 5 times, doubles value each time
; Max should track largest value: 10 → 20 → 40 → 80 → 160
; Result: (max-during-iteration 160)

; ============================================================================
; EXAMPLE 5: Sierpiński Priority Insertion (fractal priorities)
; ============================================================================

; Start with priority space (1) and (2)
(insert-between (1) and (2))

; Self-replicating rule: subdivides priority space
(exec (0)
  (, (insert-between $A and $B))
  (O (+ (priority-exists (midpoint $A $B)))
     (+ (can-insert-between $A and (midpoint $A $B)))
     (+ (can-insert-between (midpoint $A $B) and $B))
     (- (insert-between $A and $B))))

; Pattern:
; (1) ────────── (2)           Initially
; (1) ── (1 5) ── (2)           After 1 subdivision
; (1) (1 2 5) (1 5) (1 7 5) (2) After 2 subdivisions
; ... continues fractally

; This demonstrates INFINITE subdivision using structured priorities!

; ============================================================================
; EXAMPLE 6: Self-replication chain (state machine)
; ============================================================================

(state init)

; State machine using self-replication
(exec 5
  (, (state init))
  (O (+ (state loading))
     (- (state init))))

(exec 6
  (, (state loading))
  (O (+ (state processing))
     (- (state loading))))

(exec 7
  (, (state processing))
  (O (+ (state done))
     (- (state processing))))

; Expected: init → loading → processing → done
; Each state transition is a self-replication pattern

; ============================================================================
; KEY INSIGHTS
; ============================================================================
;
; 1. SELF-REPLICATION PATTERN:
;    (exec P (, (data $x)) (O (+ (data (transform $x))) (- (data $x))))
;                          ────────────────────────────────────────
;                          Produces new data that matches same pattern!
;
; 2. WHY IT'S FUNDAMENTAL:
;    - Enables iteration without explicit loops
;    - Natural recursion
;    - State propagation
;    - Fractal/recursive structures
;
; 3. TERMINATION:
;    - Limited steps (--steps flag)
;    - Guard conditions (only replicate if condition met)
;    - Data transformation that eventually doesn't match
;
; 4. FRACTAL PRIORITIES:
;    - Use tuples: (1) < (1 5) < (2)
;    - Subdivide by inserting: (1) < (1 2 5) < (1 5)
;    - Infinite refinement possible!
;
; 5. ITERATION TYPES:
;    - Linear: counter (n → n+1)
;    - Exponential: doubling (v → v*2)
;    - Fractal: subdivision (segment → 2 segments)
;    - State machine: fixed transitions
;
; This is THE fundamental pattern in MORK/MM2!
