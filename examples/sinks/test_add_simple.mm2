; Test: Simple ADD operation
; ===========================
;
; Demonstrates: (O (+ <template>)) to add facts to the space
; Shows how new facts are created during execution

; Initial trigger
(start)

; Rule: Add three new facts when triggered
(exec (0 create-facts)
  (, (start))
  (O (+ (color apple red))
     (+ (color banana yellow))
     (+ (color grape purple))
     (- (start))))

; Expected output after execution:
; (color apple red)
; (color banana yellow)
; (color grape purple)
;
; The (start) trigger is consumed, three color facts are added.
