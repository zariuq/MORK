; Test: Variable Unification and Constraints
;
; Variables in MORK/MM2 use unification semantics
; Same variable used multiple times = equality constraint

; ============================================================================
; TEST 1: Same variable twice = must be equal
; ============================================================================

(pair 5 5)
(pair 3 7)
(pair 8 8)
(pair 2 9)

; Pattern (pair $x $x) means: both elements must be the SAME
(exec 0
  (, (pair $x $x))
  (O (+ (symmetric $x))))

; Expected: Only pairs where both elements match
; (symmetric 5) - from (pair 5 5)
; (symmetric 8) - from (pair 8 8)
; NOT (pair 3 7) or (pair 2 9)

; ============================================================================
; TEST 2: Multiple variables = all must unify consistently
; ============================================================================

(triple 1 2 3)
(triple 5 5 5)
(triple 7 8 7)
(triple 9 9 9)

; Pattern (triple $a $a $a) = all three must be equal
(exec 1
  (, (triple $a $a $a))
  (O (+ (all-same $a))))

; Expected: Only triples where all three are equal
; (all-same 5) - from (triple 5 5 5)
; (all-same 9) - from (triple 9 9 9)

; ============================================================================
; TEST 3: Partial unification
; ============================================================================

(data 1 2 1)
(data 3 4 5)
(data 6 7 6)
(data 8 8 9)

; Pattern (data $x $y $x) = first and third must match, middle can be different
(exec 2
  (, (data $x $y $x))
  (O (+ (bookends-match $x middle $y))))

; Expected: First and third element match
; (bookends-match 1 middle 2) - from (data 1 2 1)
; (bookends-match 6 middle 7) - from (data 6 7 6)
; NOT (data 3 4 5) - first ≠ third
; NOT (data 8 8 9) - first ≠ third

; ============================================================================
; TEST 4: Unification with max sink
; ============================================================================

(record alice alice 30)  ; name appears twice
(record bob bob 25)      ; name appears twice
(record charlie david 35) ; names don't match

; Only process records where first two fields match
(exec 3
  (, (record $name $name $age))
  (O (max (max-age-valid $m) $m $age)))

; Expected: (max-age-valid 30)
; Only alice(30) and bob(25) have matching names
; charlie's record doesn't match the pattern

; ============================================================================
; TEST 5: Cross-pattern unification
; ============================================================================

(student alice)
(student bob)
(enrolled alice math)
(enrolled alice science)
(enrolled bob math)
(grade alice math 90)
(grade alice science 85)
(grade bob math 88)

; Find students enrolled in a course AND have a grade in it
; $s and $c must unify across all three patterns
(exec 4
  (, (student $s)
     (enrolled $s $c)
     (grade $s $c $g))
  (O (max (max-grade $m) $m $g)))

; Expected: (max-grade 90)
; All three match for:
; - alice, math, 90
; - alice, science, 85
; - bob, math, 88
; Maximum is 90

; ============================================================================
; TEST 6: Unification failure = no match
; ============================================================================

(mismatch 1 2 3)
(mismatch 4 5 6)

; This pattern CAN'T match - requires all three equal but none are
(exec 5
  (, (mismatch $z $z $z))
  (O (+ (impossible $z))))

; Expected: NO OUTPUT
; No (mismatch ...) fact has all three elements equal

; ============================================================================
; SUMMARY
; ============================================================================
;
; Unification Rules:
;
; 1. ✅ Same variable = equality constraint
;    - (pair $x $x) requires both elements equal
;
; 2. ✅ Works across multiple positions
;    - (triple $a $a $a) requires all three equal
;    - (data $x $y $x) requires first = third
;
; 3. ✅ Works across patterns in conjunction
;    - Variables unify consistently across ALL patterns
;    - Acts like SQL JOIN on shared variables
;
; 4. ✅ Works with sinks
;    - Unification happens BEFORE sink processes
;    - Sink sees only unified matches
;
; 5. ✅ Failure to unify = no match
;    - If constraint can't be satisfied, pattern doesn't match
;    - Clean failure semantics
