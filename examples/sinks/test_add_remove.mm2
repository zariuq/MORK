; Test: Add and remove operations (O wrapper)
; ============================================
;
; Demonstrates: (O (+ <fact>)) to add, (O (- <fact>)) to remove
; Shows how facts are added and consumed during execution

; Setup: Initial facts
(task buy-milk)
(task write-code)
(task read-book)

; Add a trigger
(process-tasks)

; Test: Process one task and mark it done
(exec (0 complete-task)
  (, (process-tasks)
     (task $name))
  (O (+ (completed $name))
     (- (task $name))
     (- (process-tasks))))

; Expected output:
; (completed buy-milk)  OR  (completed write-code)  OR  (completed read-book)
;
; One of the tasks will be removed and marked completed.
; The other two tasks remain in the space.
