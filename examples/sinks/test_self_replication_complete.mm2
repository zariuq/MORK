; Test: Complete Self-Replication Patterns
;
; Demonstrates all key self-replication patterns in MORK/MM2:
; 1. Basic counter
; 2. Fibonacci sequence
; 3. Sierpiński fractal priorities
; 4. Self-replication with max sink
; 5. State machine

; ============================================================================
; TEST 1: Basic Counter (5 iterations)
; ============================================================================

(counter-start 0)

(exec (0)
  (, (counter-start $n))
  (O (+ (counter-log step $n))
     (+ (counter-start (+ $n 1)))
     (- (counter-start $n))))

; With --steps 5, produces:
; (counter-log step 0), (counter-log step 1), ..., (counter-log step 4)
; Final state: (counter-start 5)

; ============================================================================
; TEST 2: Fibonacci Self-Replication (8 steps)
; ============================================================================

(fib 0 0 1)

(exec (1)
  (, (fib $n $a $b))
  (O (+ (fibonacci $n is $a))
     (+ (fib (+ $n 1) $b (+ $a $b)))
     (- (fib $n $a $b))))

; Self-replicates through Fibonacci sequence:
; (fib 0 0 1) → (fibonacci 0 is 0), (fib 1 1 1)
; (fib 1 1 1) → (fibonacci 1 is 1), (fib 2 1 2)
; (fib 2 1 2) → (fibonacci 2 is 1), (fib 3 2 3)
; (fib 3 2 3) → (fibonacci 3 is 2), (fib 4 3 5)
; etc.

; ============================================================================
; TEST 3: Doubling with Max Sink (iteration + aggregation)
; ============================================================================

(doubling-value 5)

(exec (2)
  (, (doubling-value $v))
  (O (max (max-during-doubling $m) $m $v)
     (+ (doubling-value (* $v 2)))
     (- (doubling-value $v))))

; Run 4 steps:
; Step 1: v=5   → max sees 5,   produces v=10
; Step 2: v=10  → max sees 10,  produces v=20
; Step 3: v=20  → max sees 20,  produces v=40
; Step 4: v=40  → max sees 40,  produces v=80
; Result: (max-during-doubling 40) - max of 5,10,20,40

; ============================================================================
; TEST 4: State Machine
; ============================================================================

(machine-state idle)

(exec (3 0)
  (, (machine-state idle))
  (O (+ (transition idle-to-active))
     (+ (machine-state active))
     (- (machine-state idle))))

(exec (3 1)
  (, (machine-state active))
  (O (+ (transition active-to-processing))
     (+ (machine-state processing))
     (- (machine-state active))))

(exec (3 2)
  (, (machine-state processing))
  (O (+ (transition processing-to-done))
     (+ (machine-state done))
     (- (machine-state processing))))

; State chain: idle → active → processing → done

; ============================================================================
; TEST 5: Sierpiński Fractal Priority Demonstration
; ============================================================================

(sierpinski-marker)

; These all trigger from the SAME fact but at different priorities
; Demonstrating fractal subdivision of priority space

(exec (10)
  (, (sierpinski-marker))
  (O (+ (fractal-level coarse-10))))

(exec (10 5)
  (, (sierpinski-marker))
  (O (+ (fractal-level fine-10-5))))

(exec (10 2)
  (, (sierpinski-marker))
  (O (+ (fractal-level finer-10-2))))

(exec (10 5 3)
  (, (sierpinski-marker))
  (O (+ (fractal-level finest-10-5-3))))

(exec (10 7)
  (, (sierpinski-marker))
  (O (+ (fractal-level finer-10-7))))

(exec (20)
  (, (sierpinski-marker))
  (O (+ (fractal-level coarse-20))))

; Execution order demonstrates Sierpiński pattern:
; (10) → (10 2) → (10 5) → (10 5 3) → (10 7) → (20)
;
; Visual:
;   (10) ─────────── (20)
;    │
;  ┌─┴─┐
; (10 2) (10 5)  (10 7)
;         │
;       (10 5 3)
;
; Can ALWAYS insert between any two priorities!

; ============================================================================
; EXPECTED RESULTS (with --steps 20)
; ============================================================================
;
; From TEST 1 (counter):
; - (counter-log step 0) through (counter-log step 4)
; - Final: (counter-start 5)
;
; From TEST 2 (fibonacci):
; - (fibonacci 0 is 0), (fibonacci 1 is 1), (fibonacci 2 is 1),
;   (fibonacci 3 is 2), (fibonacci 4 is 3), (fibonacci 5 is 5),
;   (fibonacci 6 is 8), (fibonacci 7 is 13)
; - Final: (fib 8 13 21)
;
; From TEST 3 (doubling with max):
; - (max-during-doubling 40)
; - Final: (doubling-value 80)
;
; From TEST 4 (state machine):
; - (transition idle-to-active)
; - (transition active-to-processing)
; - (transition processing-to-done)
; - Final: (machine-state done)
;
; From TEST 5 (Sierpiński):
; - All fractal-level markers in priority order
