; Test: REMOVE with pattern matching
; ===================================
;
; Demonstrates: (- <pattern>) removes exact matches, not patterns
; Shows that variables in remove templates use bound values

; Setup: Initial facts
(task buy-milk urgent)
(task write-code normal)
(task read-book leisure)
(start)

; Rule: Find urgent tasks and remove them
(exec (0 remove-urgent)
  (, (start)
     (task $name urgent))
  (O (+ (removed $name))
     (- (task $name urgent))
     (- (start))))

; Expected output:
; (removed buy-milk)
; (task write-code normal)
; (task read-book leisure)
;
; The urgent task is found via pattern matching, then removed
; with its bound variable value. The other tasks remain.
