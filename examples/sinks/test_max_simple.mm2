; Test: MAX sink - find maximum value
; ====================================
;
; Demonstrates: (O (max <report> $m <value>)) to find maximum
; Tests the new MaxSink implementation!

; Setup: Various depth levels
(depth frame-1 3)
(depth frame-2 7)
(depth frame-3 2)
(depth frame-4 5)
(depth frame-5 9)
(depth frame-6 1)

; Test: Find maximum depth
(exec 0
  (, (depth $frame $level))
  (O (max (max-depth $m) $m $level)))

; Expected output:
; (max-depth 9)
;
; The maximum depth level is 9 from frame-5.
; This is exactly what mmverify-utils.metta needs!