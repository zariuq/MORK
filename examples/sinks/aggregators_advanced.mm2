; Advanced Aggregator Tests - Edge Cases and Complex Scenarios
; =============================================================

; === Test 1: Ties - Multiple values equal to max/min ===
(tie-value a 10)
(tie-value b 10)
(tie-value c 5)
(tie-value d 10)

(exec (1 test-ties)
  (, (tie-value $id $val))
  (O (max (max-with-ties $m) $m $val)))

; Expected: (max-with-ties 10)
; All three 10s tie, but we only get one result

; === Test 2: Duplicates - MAX and COUNT with SAME variable ===
(dup-data 1 7)
(dup-data 2 3)
(dup-data 3 7)
(dup-data 4 9)
(dup-data 5 7)

(exec (2 test-duplicates)
  (, (dup-data $c $v))
  (O (max (max-of-dups $m) $m $v)
     (count (count-dups $m) $m ($c $v))
     (count (count-dups2 $m) $m $v)))

; Expected: (max-of-dups 9), (count-dups 3)
; Note: COUNT returns 3 (unique values: 3, 7, 9), not 5 (total facts)
; MUST use same variable $m for both aggregators!

; === Test 3: Empty/No matches ===
; Commented out to avoid failure - would need guard
; (exec (3 test-empty)
;   (, (nonexistent $x))
;   (O (max (max-of-empty $m) $m $x)))

; === Test 4: Single value ===
(single-val 42)

(exec (4 test-single-max)
  (, (single-val $v))
  (O (max (max-of-single $m) $m $v)))

(exec (4 test-single-min)
  (, (single-val $v))
  (O (min (min-of-single $m) $m $v)))

; Expected: (max-of-single 42), (min-of-single 42)
; Note: MAX and MIN must be in separate execs when using different variables

; === Test 5: Negative numbers ===
(temp monday -5)
(temp tuesday 3)
(temp wednesday -2)
(temp thursday 0)

(exec (5 test-negatives-max)
  (, (temp $day $deg))
  (O (max (warmest $m) $m $deg)))

(exec (5 test-negatives-min)
  (, (temp $day $deg))
  (O (min (coldest $m) $m $deg)))

; Expected: (warmest 3), (coldest -5)

; === Test 6: MAX with COUNT using SAME variable ===
(measurement exp-1 12 high)
(measurement exp-2 8 low)
(measurement exp-3 15 high)
(measurement exp-4 6 medium)

(exec (6 test-multi-var)
  (, (measurement $exp $reading $quality))
  (O (max (peak-reading $m) $m $reading)
     (count (total-measurements $m) $m (record $exp))))

; Expected: (peak-reading 15), (total-measurements 4)
; MUST use same variable $m for both aggregators!

; === Test 7: MAX with COUNT using SAME variable ===
(edge a b 5)
(edge b c 3)
(edge c d 7)
(edge d a 2)

(exec (7 test-count-complex)
  (, (edge $from $to $weight))
  (O (max (heaviest-edge $m) $m $weight)
     (count (total-edges $m) $m (graph-edge $from $to $weight))))

; Expected: (heaviest-edge 7), (total-edges 4)

; Key insights discovered:
; - Aggregators handle ties, duplicates, negatives naturally
; - **CRITICAL**: Multiple aggregators in ONE exec MUST use the SAME variable!
; - Different variables → separate execs (e.g., max with $m, min with $m2)
; - Same variable → can combine in one exec (e.g., max with $m, count with $m)
; - COUNT returns number of UNIQUE template instantiations
; - Single-value cases work correctly (max=min=value)
