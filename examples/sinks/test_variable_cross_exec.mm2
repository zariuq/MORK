; Test: Variables DO NOT bind across exec rules
; This is the KEY scoping rule in MORK/MM2

; Setup: Two facts
(fact-a 100)
(fact-b 200)

; ============================================================================
; QUESTION: If I use $x in two different exec rules, are they related?
; ANSWER: NO - each exec rule has completely independent variable scope
; ============================================================================

; First exec: binds $x to 100
(exec 0
  (, (fact-a $x))
  (O (+ (first-saw $x))))

; Second exec: binds $x to 200 (DIFFERENT binding, same variable name)
(exec 1
  (, (fact-b $x))
  (O (+ (second-saw $x))))

; Expected results:
; (first-saw 100)   - $x bound to 100 in first exec
; (second-saw 200)  - $x bound to 200 in second exec
;
; The $x variables are INDEPENDENT - no connection between them

; ============================================================================
; Contrast: Variables DO bind WITHIN an exec rule's conjunction
; ============================================================================

(connects a b)
(connects b c)
(weight a b 5)
(weight b c 3)

; This single exec has THREE patterns
; All use $x and $y - they MUST match consistently
(exec 2
  (, (connects $x $y)
     (weight $x $y $w))
  (O (+ (connection $x to $y weight $w))))

; Expected: Only two matches
; (connection a to b weight 5)  - $x=a, $y=b in BOTH patterns
; (connection b to c weight 3)  - $x=b, $y=c in BOTH patterns
;
; The variables are BOUND ACROSS the patterns in the conjunction

; ============================================================================
; SUMMARY
; ============================================================================
;
; Variable Scoping Rules:
;
; ✅ WITHIN exec rule (in conjunction):
;    Variables bind across all patterns in (,)
;    Must match consistently
;
; ❌ ACROSS exec rules:
;    Variables are independent
;    Same name = different scope
;    No shared state
