; Test: MAX sink with variable guard
; ===================================
;
; Demonstrates: (O (max <report($m)> $m <value>))
; The $m variable gets substituted with the computed maximum

; Data: Various numeric values
(depth frame-1 3)
(depth frame-2 7)
(depth frame-3 2)
(depth frame-4 9)
(depth frame-5 5)

; Exec: Find maximum depth
(exec 0
  (, (depth $frame $level))
  (O (max (max-depth $m) $m $level)))

; Expected output:
; (max-depth 9)
;
; Explanation: MaxSink collects all $level values (3, 7, 2, 9, 5),
; finds the maximum (9), and substitutes $m in the report template
