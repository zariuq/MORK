; Test: Exact pattern from mmverify collect_lists_by_depth
; This demonstrates how max/min would be used in the full mmverify workflow

; Simulate the actual mmverify pattern:
; 1. Collect hypothesis lists from different frame depths
; 2. Find max depth using max-atom
; 3. Process from depth 1 to max_depth

; Essential hypotheses at various frame depths
(ehyp-at-depth 1 (stmt-e1 a b))
(ehyp-at-depth 1 (stmt-e2 c d))
(ehyp-at-depth 3 (stmt-e3 e f))
(ehyp-at-depth 2 (stmt-e4 g h))
(ehyp-at-depth 3 (stmt-e5 i j))
(ehyp-at-depth 1 (stmt-e6 k l))

; Step 1: Extract just the depth levels
; In mmverify: ($e_levels (collapse (match-atom' $e_hyps_lists ($l $_) $l)))
(depth-marker 1)
(depth-marker 3)
(depth-marker 2)

; Step 2: Find maximum depth
; In mmverify: ($e_max_level (if (== $e_levels (())) 0 (max-atom $e_levels)))
(exec 0
  (, (depth-marker $l))
  (O (max (max-depth $m) $m $l)))

; Expected: (max-depth 3)

; Step 3: Also test minimum depth (for starting point)
(exec 1
  (, (depth-marker $l))
  (O (min (min-depth $m) $m $l)))

; Expected: (min-depth 1)

; In mmverify, the next step would be:
; (collect_lists_by_depth $e_hyps_lists 1 3 Nil)
; which processes frames from depth 1 up to depth 3 (the max)

; This demonstrates the complete pattern:
; - Find max depth → 3
; - Find min depth → 1
; - Iterate from 1 to 3 collecting hypotheses in order
; - Result: all hypotheses processed bottom-up through frame stack
