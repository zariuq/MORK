; Test: Simple addition using lookup tables
; ==========================================
;
; Demonstrates: How addition works in MORK via (A a b sum) facts

; Addition table (small subset for demo)
(A 0 0 0) (A 0 1 1) (A 0 2 2) (A 0 3 3) (A 0 4 4) (A 0 5 5)
(A 1 0 1) (A 1 1 2) (A 1 2 3) (A 1 3 4) (A 1 4 5) (A 1 5 6)
(A 2 0 2) (A 2 1 3) (A 2 2 4) (A 2 3 5) (A 2 4 6) (A 2 5 7)
(A 3 0 3) (A 3 1 4) (A 3 2 5) (A 3 3 6) (A 3 4 7) (A 3 5 8)
(A 4 0 4) (A 4 1 5) (A 4 2 6) (A 4 3 7) (A 4 4 8) (A 4 5 9)
(A 5 0 5) (A 5 1 6) (A 5 2 7) (A 5 3 8) (A 5 4 9) (A 5 5 10)

; Problems to solve
(problem add-2-plus-3)
(problem add-4-plus-1)
(problem add-5-plus-5)

; Exec: Solve addition problems
(exec 0
  (, (problem add-2-plus-3) (A 2 3 $sum))
  (O (+ (answer 2-plus-3-equals $sum))))

(exec 0
  (, (problem add-4-plus-1) (A 4 1 $sum))
  (O (+ (answer 4-plus-1-equals $sum))))

(exec 0
  (, (problem add-5-plus-5) (A 5 5 $sum))
  (O (+ (answer 5-plus-5-equals $sum))))

(exec 0
  (, (problem add-5-plus-5) (A 5 6 $sum))
  (O (+ (answer 5-plus-5-equals $sum))))

(exec 0
  (, (problem add-5-plus-5) (A 5 5 $sum))
  (O (+ (answer 5-plus-5-equals $sum))
     (+ (A 5 6 $sum))))

; Expected results:
; (answer 2-plus-3-equals 5)
; (answer 4-plus-1-equals 5)
; (answer 5-plus-5-equals 10)
