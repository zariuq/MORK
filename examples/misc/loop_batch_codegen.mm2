; Batch codegen loop: expand (range id (Cons ...)) into per-item execs, then run.

; A small range for e1: 1..5
(range e1 (Cons 1 (Cons 2 (Cons 3 (Cons 4 (Cons 5 Nil))))))
(make-loop e1)
(run e1)

; Expand head: emit a per-item exec and advance the make-loop cursor to tail.
(exec (0 make-loop-expand)
  (, (make-loop $id)
     (range $id (Cons $h $t)))
  (O (+ (exec (0 do $id $h)
           (, (run $id))
           (O (+ (did $id $h))
              (- (run $id)))))
     (+ (make-loop $id $t))
     (- (make-loop $id))))

; Iterate over the tail
(exec (0 make-loop-iterate)
  (, (make-loop $id (Cons $h $t)))
  (O (+ (exec (0 do $id $h)
           (, (run $id))
           (O (+ (did $id $h))
              (- (run $id)))))
     (+ (make-loop $id $t))
     (- (make-loop $id (Cons $h $t)))))

; Stop when Nil
(exec (1 make-loop-stop)
  (, (make-loop $id Nil))
  (O (- (make-loop $id Nil))))

