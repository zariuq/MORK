; List walkers: foreach, map (via apply), and foldl (reverse).

; Demo list: (a b c)
(foreach (Cons a (Cons b (Cons c Nil))))

; Foreach: emit (out h) for each element
(exec (0 fe-step)
  (, (foreach (Cons $h $t)))
  (O (+ (out $h))
     (+ (foreach $t))
     (- (foreach (Cons $h $t)))))

(exec (1 fe-stop)
  (, (foreach Nil))
  (O (- (foreach Nil))))

; Map via apply function: (map f list) produces (mapped h2) per element
(map up (Cons a (Cons b (Cons c Nil))))
(apply up a A)
(apply up b B)
(apply up c C)

(exec (0 map-step)
  (, (map $f (Cons $h $t))
     (apply $f $h $h2))
  (O (+ (mapped $h2))
     (+ (map $f $t))
     (- (map $f (Cons $h $t)))))

(exec (1 map-stop)
  (, (map $f Nil))
  (O (- (map $f Nil))))

; Foldl reverse: foldl rev acc list → accumulate reversed list
(foldl rev Nil (Cons a (Cons b (Cons c Nil))))

; Apply2 for rev: rev acc h → (Cons h acc)
(apply2 rev $acc $h (Cons $h $acc))

(exec (0 fold-step)
  (, (foldl $f $acc (Cons $h $t))
     (apply2 $f $acc $h $acc1))
  (O (+ (foldl $f $acc1 $t))
     (- (foldl $f $acc (Cons $h $t)))))

(exec (1 fold-stop)
  (, (foldl $f $acc Nil))
  (O (+ (fold-result $acc))
     (- (foldl $f $acc Nil))))

