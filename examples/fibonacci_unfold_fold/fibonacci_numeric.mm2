; ============================================================================
; Fibonacci with NUMERIC priorities (cleaner output)
; ============================================================================

; === Self-regenerating execs (no broadcast chain needed) ===
; Each exec re-adds itself with same priority

(exec (100 fib-base-0)
  (, (fib 0 $id))
  (O (+ (fib-result $id 0))
     (+ (exec (100 fib-base-0)
          (, (fib 0 $id2))
          (O (+ (fib-result $id2 0))
             (- (fib 0 $id2)))))
     (- (fib 0 $id))))

(exec (200 fib-base-1)
  (, (fib 1 $id))
  (O (+ (fib-result $id 1))
     (+ (exec (200 fib-base-1)
          (, (fib 1 $id2))
          (O (+ (fib-result $id2 1))
             (- (fib 1 $id2)))))
     (- (fib 1 $id))))

(exec (300 fib-unfold)
  (, (fib $n $id)
     (S $n1 $n)
     (S $n2 $n1))
  (O (+ (fib $n1 (left $id)))
     (+ (fib $n2 (right $id)))
     (+ (wait-add $id))
     (+ (exec (300 fib-unfold)
          (, (fib $n3 $id2)
             (S $n4 $n3)
             (S $n5 $n4))
          (O (+ (fib $n4 (left $id2)))
             (+ (fib $n5 (right $id2)))
             (+ (wait-add $id2))
             (- (fib $n3 $id2)))))
     (- (fib $n $id))))

(exec (400 fib-fold)
  (, (wait-add $id)
     (fib-result (left $id) $r1)
     (fib-result (right $id) $r2)
     (A $r1 $r2 $sum))
  (O (+ (fib-result $id $sum))
     (+ (exec (400 fib-fold)
          (, (wait-add $id2)
             (fib-result (left $id2) $r3)
             (fib-result (right $id2) $r4)
             (A $r3 $r4 $sum2))
          (O (+ (fib-result $id2 $sum2))
             (- (wait-add $id2))
             (- (fib-result (left $id2) $r3))
             (- (fib-result (right $id2) $r4)))))
     (- (wait-add $id))
     (- (fib-result (left $id) $r1))
     (- (fib-result (right $id) $r2))))

; === Tables ===
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6) (S 6 7) (S 7 8) (S 8 9) (S 9 10)
(A 0 0 0) (A 0 1 1) (A 0 2 2) (A 0 3 3) (A 0 4 4) (A 0 5 5)
(A 1 0 1) (A 1 1 2) (A 1 2 3) (A 1 3 4) (A 1 4 5) (A 1 5 6)
(A 2 0 2) (A 2 1 3) (A 2 2 4) (A 2 3 5) (A 2 4 6) (A 2 5 7) (A 2 6 8)
(A 3 0 3) (A 3 1 4) (A 3 2 5) (A 3 3 6) (A 3 4 7) (A 3 5 8)
(A 4 0 4) (A 4 1 5) (A 4 2 6) (A 4 3 7) (A 4 4 8)
(A 5 0 5) (A 5 1 6) (A 5 2 7) (A 5 3 8) (A 5 4 9) (A 5 5 10)

; === TEST ===
(fib 5 test)
