; ============================================================================
; Memoized Fibonacci with Full Arithmetic Tables
; ============================================================================
; Combines memoization with extensive tables to compute up to fib(12)
; Demonstrates significant performance improvement by caching intermediate values
; ============================================================================

; === Recursive pattern ===
(exec rec
  (, ((step ($priority $name)) $premises0 $conclusions0)
     (exec bc $premises1 $conclusions1)
     (S $priority $next_priority))
  (O (+ (exec ($priority $name) $premises0 $conclusions0))
     (+ (exec bc $premises1 $conclusions1))
     (- ((step ($priority $name)) $premises0 $conclusions0))
     (+ ((step ($next_priority $name)) $premises0 $conclusions0))))

