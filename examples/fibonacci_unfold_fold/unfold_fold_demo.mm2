; ============================================================================
; UNFOLD/FOLD Pattern - Simplest Example
; ============================================================================
; Demonstrates the two-phase pattern of recursive computation:
; 1. UNFOLD: Break problem into parts
; 2. FOLD: Combine results
; ============================================================================

; Broadcast chain to keep rules persistent
(exec bc
  (, ((step ($priority $name)) $premises0 $conclusions0)
     (exec bc $premises1 $conclusions1))
  (O (+ (exec ($priority $name) $premises0 $conclusions0))
     (+ (exec bc $premises1 $conclusions1))
     (- ((step ($priority $name)) $premises0 $conclusions0))
     (+ ((step ((S ($priority)) $name)) $premises0 $conclusions0))))

; === UNFOLD PHASE ===
; Task: compute double(5)
; Unfold it to: add(5, 5)
((step (0 unfold-double))
  (, (double $n $id))
  (O (+ (add $n $n (work-for $id)))
     (+ (waiting $id))
     (- (double $n $id))))

; === WORK PHASE ===
; Do the actual computation
((step (1 do-add))
  (, (add 5 5 $id))
  (O (+ (result $id 10))
     (- (add 5 5 $id))))

; === FOLD PHASE ===
; Collect the result
((step (2 fold-result))
  (, (waiting $id)
     (result (work-for $id) $value))
  (O (+ (final $id $value))
     (- (waiting $id))
     (- (result (work-for $id) $value))))

; === RUN ===
(double 5 task)
