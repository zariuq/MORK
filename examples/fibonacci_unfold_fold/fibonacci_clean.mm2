; Fibonacci: Clean unfold/fold demonstration
; Uses broadcast chain pattern to avoid premature exec consumption

; === Broadcast chain for rules ===
; Extract individual execs from a chain to ensure they persist
(exec bc
  (, ((step ($priority $name)) $premises0 $conclusions0)
     (exec bc $premises1 $conclusions1))
  (O (+ (exec ($priority $name) $premises0 $conclusions0))
     (+ (exec bc $premises1 $conclusions1))
     (- ((step ($priority $name)) $premises0 $conclusions0))
     (+ ((step ((S ($priority)) $name)) $premises0 $conclusions0))))

; === Rules as steps (will be extracted by broadcast chain) ===

; Base case: fib(0) = 0
((step (0 fib-base-0))
  (, (fib 0 $id))
  (O (+ (fib-result $id 0))
     (- (fib 0 $id))))

; Base case: fib(1) = 1
((step (1 fib-base-1))
  (, (fib 1 $id))
  (O (+ (fib-result $id 1))
     (- (fib 1 $id))))

; UNFOLD: fib(2) → fib(1) + fib(0)
((step (2 fib-2-unfold))
  (, (fib 2 $id))
  (O (+ (fib 1 (left $id)))
     (+ (fib 0 (right $id)))
     (+ (wait-2 $id))
     (- (fib 2 $id))))

; FOLD: combine results
((step (3 fib-2-fold))
  (, (wait-2 $id)
     (fib-result (left $id) 1)
     (fib-result (right $id) 0))
  (O (+ (fib-result $id 1))
     (- (wait-2 $id))
     (- (fib-result (left $id) 1))
     (- (fib-result (right $id) 0))))

; === Test ===
; Compute fib(2):
; 1. UNFOLD: fib(2) → fib(1) + fib(0), wait-2
; 2. BASE: fib(1) → result 1
; 3. BASE: fib(0) → result 0
; 4. FOLD: wait-2 + results → fib-result 1
(fib 2 main)
