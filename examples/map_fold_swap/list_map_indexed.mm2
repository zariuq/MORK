; list_map using INDEXED list representation
; Apply a function to each element
; Example: double each number [1,2,3] → [2,4,6]

; Input list as indexed atoms
(list input 0 5)
(list input 1 3)
(list input 2 1)

; Metadata: what we're mapping
(map-list input 0 double)  ; (map-list name start-index function)

; Function table: double(x) = 2*x
(double 1 2)
(double 2 4)
(double 3 6)
(double 4 8)
(double 5 10)

; Main map rule: applies function to element at index i
; Stops naturally when (list $name $i $x) doesn't match!
(exec map
  (, (map-list $name $i $fn)
     (list $name $i $x)       ; Get element at index i (fails when no more items)
     ($fn $x $result)         ; Apply function
     (succ $i $i1)
     (exec map $p $t))
  (O (- (map-list $name $i $fn))
     (- (list $name $i $x))   ; Consume input
     (+ (list-out $name $i $result))  ; Output result at SAME index
     (+ (map-list $name $i1 $fn))
     (+ (exec map $p $t))))

; Helpers
(succ 0 1) (succ 1 2) (succ 2 3) (succ 3 4) (succ 4 5)

; Expected output:
; (list-out input 0 2)  ← double(1)
; (list-out input 1 4)  ← double(2)
; (list-out input 2 6)  ← double(3)
