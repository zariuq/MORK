; fold_sum_loop: Sum elements using the loop pattern from loop_dynamic.mm2
; Instead of self-replication, use a loop gate that counts remaining iterations!
;
; Sum meep list: [2, 4, 1, 3, 5] → 15

; Input list (5 elements)
(list meep 0 2)
(list meep 1 4)
(list meep 2 1)
(list meep 3 3)
(list meep 4 5)

; Successor table for counting (indices and remaining)
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6)

; Addition table
(add 0 1 1)
(add 0 2 2)
(add 0 3 3)
(add 0 4 4)
(add 0 5 5)
(add 2 4 6)
(add 6 1 7)
(add 7 3 10)
(add 10 5 15)

; Initialize: index=0, remaining=5, accumulator=0
; (loop-sum index remaining accumulator)
(loop-sum 0 5 0)

; Stop when rem==1: process final element and output result
(exec (1 loop-stop)
  (, (loop-sum $i 1 $acc)
     (list meep $i $x)
     (add $acc $x $final)
     (exec (1 loop-stop) $p $t))  ; Self-replication to keep rule alive
  (O (+ (sum-result $final))
     (- (loop-sum $i 1 $acc))
     (- (list meep $i $x))
     (+ (exec (1 loop-stop) $p $t))))

; Step when rem>=2: add current element to accumulator, continue loop
; Requires: S rem2 rem1, S rem1 rem (to ensure rem >= 2)
(exec (0 loop-step)
  (, (loop-sum $i $rem $acc)
     (S $rem1 $rem)           ; rem1 = rem - 1
     (S $rem2 $rem1)          ; rem2 = rem - 2 (ensures rem >= 2)
     (list meep $i $x)        ; Get element at index i
     (add $acc $x $new_acc)   ; Add to accumulator
     (S $i $i1)               ; Next index
     (exec (0 loop-step) $p2 $t2))  ; Self-replication
  (O (+ (loop-sum $i1 $rem1 $new_acc))  ; Continue with i+1, rem-1, new_acc
     (- (loop-sum $i $rem $acc))
     (- (list meep $i $x))
     (+ (exec (0 loop-step) $p2 $t2))))

; Expected output:
; (sum-result 15)  ← 2+4+1+3+5 = 15
;
; Loop execution trace:
; Step 0: i=0, rem=5, acc=0, x=2 → acc=2,  continue with i=1, rem=4
; Step 1: i=1, rem=4, acc=2, x=4 → acc=6,  continue with i=2, rem=3
; Step 2: i=2, rem=3, acc=6, x=1 → acc=7,  continue with i=3, rem=2
; Step 3: i=3, rem=2, acc=7, x=3 → acc=10, continue with i=4, rem=1
; Step 4: i=4, rem=1, acc=10, x=5 → final=15, STOP!
;
; Comparison with self-replication version (fold_sum.mm2):
; - Loop version: Explicit remaining counter tracks iterations
; - Loop version: Uses priority-based stop condition (rem==1 vs rem>=2)
; - Regular version: Just checks if list element exists
; - Both use self-replication to keep exec rules alive!
;
; The "loop" pattern from loop_dynamic.mm2:
; - (loop-sum index remaining accumulator) ← the loop state
; - Priority 0 (loop-step): Fires when rem >= 2
; - Priority 1 (loop-stop): Fires when rem == 1 (lower priority, last resort)
; - Uses S (successor) relation to count down: S rem1 rem means rem-1
; - Checks S rem2 rem1 to ensure rem >= 2 (guards against rem==1 firing loop-step)
