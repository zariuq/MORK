; fold_sum: Sum all elements in a list using fold
; This REQUIRES sequential processing because we accumulate a running total.
;
; Example: [5, 3, 1] → 0+5=5, 5+3=8, 8+1=9

; Input list
(list input 0 5)
(list input 1 3)
(list input 2 1)

; Start folding from index 0 with accumulator 0
(fold-sum input 0 0)  ; (fold-sum name index accumulator)

; Addition table
(add 0 1 1)
(add 0 3 3)
(add 0 5 5)
(add 1 3 4)
(add 1 5 6)
(add 3 5 8)
(add 5 3 8)
(add 8 1 9)

; Successor
(succ 0 1) (succ 1 2) (succ 2 3) (succ 3 4)

; Main fold rule: add current element to accumulator
(exec fold
  (, (fold-sum $name $i $acc)
     (list $name $i $x)           ; Get element at index i
     (add $acc $x $new_acc)       ; Add to accumulator
     (succ $i $i1)
     (exec fold $p $t))
  (O (- (fold-sum $name $i $acc))
     (- (list $name $i $x))
     (+ (fold-sum $name $i1 $new_acc))  ; Continue with new accumulator
     (+ (exec fold $p $t))))

; Base case: no more elements, output final sum
(exec fold-done
  (, (fold-sum $name $i $acc))
  (O (- (fold-sum $name $i $acc))
     (+ (sum-result $acc))))

; Expected output:
; (sum-result 9)  ← 5+3+1 = 9
;
; Why this MUST be sequential:
; - Step 1: acc=0, x=5 → new_acc=5
; - Step 2: acc=5, x=3 → new_acc=8  (depends on step 1!)
; - Step 3: acc=8, x=1 → new_acc=9  (depends on step 2!)
;
; Cannot use SIMD because each addition depends on the previous result.
; This is the classic fold pattern - inherently sequential.
