; FOR-LOOP TEMPLATE: Cookie cutter pattern for iterating over a list with accumulation
;
; This is a TEMPLATE showing the structure. Replace the PLACEHOLDER comments with your operation!
;
; Pattern:
;   (for-loop-NAME index remaining accumulator)
;
; Two exec rules:
;   - Priority 0 (loop-step): Process one element, continue loop
;   - Priority 1 (loop-stop): Process final element, output result

; ============================================================================
; EXAMPLE 1: SUM - Add all elements
; ============================================================================

; Input list
(list nums 0 2)
(list nums 1 4)
(list nums 2 3)

; Start: index=0, remaining=3, accumulator=0
(for-loop-sum 0 3 0)

; Addition operation
(add 0 2 2)
(add 0 3 3)
(add 0 4 4)
(add 2 4 6)
(add 6 3 9)

; Successor for counting
(S 0 1) (S 1 2) (S 2 3) (S 3 4)

; STOP rule (rem==1): Final element
(exec (1 sum-stop)
  (, (for-loop-sum $i 1 $acc)
     (list nums $i $x)
     (add $acc $x $result)              ; OPERATION: add
     (exec (1 sum-stop) $p $t))
  (O (+ (sum-result $result))           ; OUTPUT: sum-result
     (- (for-loop-sum $i 1 $acc))
     (- (list nums $i $x))
     (+ (exec (1 sum-stop) $p $t))))

; STEP rule (rem>=2): Process and continue
(exec (0 sum-step)
  (, (for-loop-sum $i $rem $acc)
     (S $rem1 $rem)
     (S $rem2 $rem1)                    ; Guard: ensures rem >= 2
     (list nums $i $x)
     (add $acc $x $new_acc)             ; OPERATION: add
     (S $i $i1)
     (exec (0 sum-step) $p $t))
  (O (+ (for-loop-sum $i1 $rem1 $new_acc))
     (- (for-loop-sum $i $rem $acc))
     (- (list nums $i $x))
     (+ (exec (0 sum-step) $p $t))))

; ============================================================================
; EXAMPLE 2: PRODUCT - Multiply all elements
; ============================================================================

; Input list (SEPARATE list so sum doesn't consume it!)
(list vals 0 2)
(list vals 1 4)
(list vals 2 3)

; Start: index=0, remaining=3, accumulator=1 (multiplicative identity!)
(for-loop-prod 0 3 1)

; Multiplication operation
(mul 1 2 2)
(mul 1 3 3)
(mul 1 4 4)
(mul 2 4 8)
(mul 8 3 24)

; STOP rule (rem==1): Final element
(exec (1 prod-stop)
  (, (for-loop-prod $i 1 $acc)
     (list vals $i $x)                  ; LISTNAME: vals (CHANGED!)
     (mul $acc $x $result)              ; OPERATION: mul (CHANGED!)
     (exec (1 prod-stop) $p $t))
  (O (+ (prod-result $result))          ; OUTPUT: prod-result (CHANGED!)
     (- (for-loop-prod $i 1 $acc))
     (- (list vals $i $x))
     (+ (exec (1 prod-stop) $p $t))))

; STEP rule (rem>=2): Process and continue
(exec (0 prod-step)
  (, (for-loop-prod $i $rem $acc)
     (S $rem1 $rem)
     (S $rem2 $rem1)
     (list vals $i $x)                  ; LISTNAME: vals (CHANGED!)
     (mul $acc $x $new_acc)             ; OPERATION: mul (CHANGED!)
     (S $i $i1)
     (exec (0 prod-step) $p $t))
  (O (+ (for-loop-prod $i1 $rem1 $new_acc))
     (- (for-loop-prod $i $rem $acc))
     (- (list vals $i $x))
     (+ (exec (0 prod-step) $p $t))))

; Expected output:
; (sum-result 9)   ← 2 + 4 + 3 = 9
; (prod-result 24) ← 2 * 4 * 3 = 24

; ============================================================================
; COOKIE CUTTER TEMPLATE: Fill in the blanks!
; ============================================================================
;
; ; Input list
; (list LISTNAME 0 VAL0)
; (list LISTNAME 1 VAL1)
; ...
;
; ; Start loop: (for-loop-OPNAME index remaining initial_accumulator)
; (for-loop-OPNAME 0 LENGTH IDENTITY_VALUE)
;
; ; OPERATION table (add/mul/max/min/etc)
; (OPERATION ARG1 ARG2 RESULT)
; ...
;
; ; Successor for counting
; (S 0 1) (S 1 2) ... (S LENGTH (+ LENGTH 1))
;
; ; STOP rule (rem==1)
; (exec (1 OPNAME-stop)
;   (, (for-loop-OPNAME $i 1 $acc)
;      (list LISTNAME $i $x)
;      (OPERATION $acc $x $result)
;      (exec (1 OPNAME-stop) $p $t))
;   (O (+ (OPNAME-result $result))
;      (- (for-loop-OPNAME $i 1 $acc))
;      (- (list LISTNAME $i $x))
;      (+ (exec (1 OPNAME-stop) $p $t))))
;
; ; STEP rule (rem>=2)
; (exec (0 OPNAME-step)
;   (, (for-loop-OPNAME $i $rem $acc)
;      (S $rem1 $rem)
;      (S $rem2 $rem1)
;      (list LISTNAME $i $x)
;      (OPERATION $acc $x $new_acc)
;      (S $i $i1)
;      (exec (0 OPNAME-step) $p $t))
;   (O (+ (for-loop-OPNAME $i1 $rem1 $new_acc))
;      (- (for-loop-OPNAME $i $rem $acc))
;      (- (list LISTNAME $i $x))
;      (+ (exec (0 OPNAME-step) $p $t))))
;
; ============================================================================
; What to change for different operations:
; ============================================================================
; 1. OPNAME: Operation name (sum, prod, max, min, concat, etc.)
; 2. LISTNAME: Name of your list
; 3. OPERATION: The binary operation (add, mul, max, min, etc.)
; 4. IDENTITY_VALUE: Initial accumulator value
;    - Sum: 0 (additive identity)
;    - Product: 1 (multiplicative identity)
;    - Max: -infinity (or smallest possible value)
;    - Min: +infinity (or largest possible value)
; 5. OPERATION table: Preload all needed operation facts
; 6. Output atom name: OPNAME-result
;
; The structure stays THE SAME, just fill in the placeholders!
