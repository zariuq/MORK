; Dynamic per-iteration loop: for i=1..10, emit (did i)
; Uses a finite successor table and a gate that counts remaining iterations.

; Successor table 0..12
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6)
(S 6 7) (S 7 8) (S 8 9) (S 9 10) (S 10 11) (S 11 12)

; Initialize: start at i=1 with rem=10 iterations
(loop 1 10)

; Stop when rem==1: emit (did i) and finish
(exec (1 loop-stop)
  (, (loop $i 1))
  (O (+ (did $i))
     (- (loop $i 1))))

; Step when rem>=2: requires rem1, rem2 such that S rem2 rem1, S rem1 rem
; i increments to i1, rem decrements to rem1
(exec (0 loop-step)
  (, (loop $i $rem)
     (S $rem1 $rem)
     (S $rem2 $rem1)
     (S $i $i1))
  (O (+ (did $i))
     (+ (loop $i1 $rem1))
     (- (loop $i $rem))))

