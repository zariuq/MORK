; swap_pairs_simd: SIMD-style parallel swap
; Process ALL pairs at once instead of sequentially!
; Each pair gets its own exec rule that fires independently.

; Input list - each element is a 2-element pair
(list input 0 (3 dog))
(list input 1 (5 cow))
(list input 2 (7 pig))
(list input 3 (2 hen))

; SIMD approach: One exec with $i variable matches ALL pairs at once!
; No self-replication, no loops - pure parallel SIMD!

(exec swap
  (, (list input $i ($first $second)))
  (O (- (list input $i ($first $second)))
     (+ (list-out input $i ($second $first)))))

; Expected output (all pairs swapped in ONE step!):
; (list-out input 0 (dog 3))  ← was (3 dog)
; (list-out input 1 (cow 5))  ← was (5 cow)
; (list-out input 2 (pig 7))  ← was (7 pig)
; (list-out input 3 (hen 2))  ← was (2 hen)
;
; Performance comparison:
; - Sequential: 4 steps, transitions grow with each step
; - SIMD: 1 step, 20 transitions ⚡
;
; The magic: $i matches ALL indices, so all pairs are swapped simultaneously!
; This is true SIMD-style parallel processing - no dependencies, pure parallelism.
