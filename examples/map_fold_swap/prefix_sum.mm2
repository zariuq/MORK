; prefix_sum: Cumulative/running sum - each output is sum of all elements up to that point
; This STRONGLY requires order WITHIN each list - element i depends on output at i-1!
; BUT: Multiple lists can be processed in PARALLEL - they're independent!
;
; Example:
;   input: [5, 3, 1] → [5, 8, 9]
;   meep:  [9, 7, 8] → [9, 16, 24]

; Input lists
(list input 0 5)
(list input 1 3)
(list input 2 1)

(list meep 0 9)
(list meep 1 7)
(list meep 2 8)

; Start prefix_sum for BOTH lists with index 0, running_sum 0
; The $name variable in the exec will handle both!
(prefix input 0 0)  ; Process 'input' list
(prefix meep 0 0)   ; Process 'meep' list in parallel!

; Addition table
(add 0 1 1)
(add 0 3 3)
(add 0 5 5)
(add 1 3 4)
(add 5 3 8)
(add 8 1 9)
(add 0 9 9)
(add 9 7 16)
(add 16 8 24)

; Successor
(succ 0 1) (succ 1 2) (succ 2 3)

; Prefix rule: output running sum, then continue
(exec prefix
  (, (prefix $name $i $running_sum)
     (list $name $i $x)                 ; Get element at index i
     (add $running_sum $x $new_sum)     ; Add to running sum
     (succ $i $i1)
     (exec prefix $p $t))
  (O (- (prefix $name $i $running_sum))
     (- (list $name $i $x))
     (+ (list-out $name $i $new_sum))   ; Output cumulative sum at position i
     (+ (prefix $name $i1 $new_sum))    ; Continue with new running sum
     (+ (exec prefix $p $t))))

; Base case: no more elements
(exec prefix-done
  (, (prefix $name $i $running_sum))
  (O (- (prefix $name $i $running_sum))
     (+ (prefix-complete))))

; Expected output:
; (list-out input 0 5)    ← input running sum: 0+5 = 5
; (list-out input 1 8)    ← input running sum: 5+3 = 8
; (list-out input 2 9)    ← input running sum: 8+1 = 9
; (list-out meep 0 9)     ← meep running sum: 0+9 = 9
; (list-out meep 1 16)    ← meep running sum: 9+7 = 16
; (list-out meep 2 24)    ← meep running sum: 16+8 = 24
; (prefix-complete)       ← Base case doesn't track which list, but both completed!
;
; Key insight - TWO levels of parallelism:
; - WITHIN a list: MUST be sequential (element i depends on i-1)
; - ACROSS lists: Can be PARALLEL! (input and meep are independent)
;
; The exec rule with $name variable handles BOTH lists!
; MM2 interleaves them, showing they're independent operations.
