; Loop Until 10 - Bootstrap Pattern
; Defines logic as data (step-data).
; Uses a persistent Runner to continuously instantiate rules.

; === 0. Arithmetic ===
(succ 0 1) (succ 1 2) (succ 2 3) (succ 3 4) (succ 4 5)
(succ 5 6) (succ 6 7) (succ 7 8) (succ 8 9) (succ 9 10)

; === 1. State ===
(state 0)

; === 2. Logic Data ===

; Stop Rule (Priority 0)
(step-data (0 Stop) 
           (, (state 10)) 
           (O (+ (DONE)) (- (state 10))))

; Step Rule (Priority 1)
(step-data (1 Step) 
           (, (state $n) (succ $n $next)) 
           (O (+ (state $next)) (+ (trace $n)) (- (state $n))))

; === 3. The Runner (Bootstrap) ===
; Continuously reads step-data and creates active execs.
; Self-regenerating.

(exec (99 Runner)
      (, (step-data $prio_name $prem $conc)
         (exec (99 Runner) $rp $rc)) ; Match self
      (O (+ (exec $prio_name $prem $conc)) ; Spawn rule
         (+ (exec (99 Runner) $rp $rc))))  ; Respawn runner
