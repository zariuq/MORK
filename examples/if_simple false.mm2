; Minimal MM2 "if" via two execs and a run token.
; If (A) is present when (if-run) is set, emit (B); otherwise emit (C).
; Ordering is enforced by exec name prefix: lower comes first.

; Toggle this fact to choose the branch:
(if-run)
;(A)   ; comment this line to test the else branch

; True branch: requires both (if-run) and (A)
(exec (0 if-true)
  (, (if-run)
     (A))
  (O (+ (B))
     (- (if-run))))

; Else branch: fires only if true branch didn't consume (if-run)
(exec (1 if-false)
  (, (if-run))
  (O (+ (C))
     (- (if-run))))

