; Dynamic if-then-else via exec creation (macro style)
; Data: (if <id> <cond> <then> <else>), gate: (if-make <id>), run: (if-run <id>)
; The macro creates two execs dynamically: (0 if-true <id>) and (1 if-false <id>).

; --- Demo: if-statement with code generation ---
; Define an if-statement, trigger macro expansion, then execute
(if e1 (condition-holds) (result then-branch) (result else-branch))
(if-make e1)
(if-run e1)
(condition-holds)   ; Toggle this to choose branch

; --- Macro expansion: create per-id execs ---
(exec (0 if-macro-expand)
  (, (if $id $cond $then $else)
     (if-make $id))
  (O
    (+ (exec (0 if-true $id)
         (, $cond
            (if-run $id))
         (O (+ $then)
            (- (if-run $id)))))
    (+ (exec (1 if-false $id)
         (, (if-run $id))
         (O (+ $else)
            (- (if-run $id)))))
    (- (if-make $id))
  ))

