; Test: Fractal Priority Insertion with Structured Tuples
;
; PROBLEM: With shortlex, you can't insert between 1 and 2 indefinitely
;   - 1 < 2 (both length 1)
;   - Can't insert "1.5" because 1 < 2 < 10 (shortlex!)
;
; SOLUTION: Use structured priorities like (1 5) for "1.5"
;   - (1) < (1 5) < (2) in tuple comparison
;   - Can subdivide infinitely by adding more elements!

; ============================================================================
; LEVEL 1: Initial priorities
; ============================================================================

(step-1-0 start)

(exec (1)
  (, (step-1-0 $x))
  (O (+ (step-1-1 middle))
     (- (step-1-0 $x))))

(step-1-1 end)

(exec (2)
  (, (step-1-1 $x))
  (O (+ (step-1-2 $x))
     (- (step-1-1 $x))))

; Expected execution order: (1) then (2)
; State: start → middle → end

; ============================================================================
; LEVEL 2: Insert between (1) and (2) using (1 5)
; ============================================================================

(step-2-0 start)

(exec (1)
  (, (step-2-0 $x))
  (O (+ (step-2-1 after-1))
     (- (step-2-0 $x))))

; INSERT: This fires BETWEEN (1) and (2)!
(exec (1 5)
  (, (step-2-1 $x))
  (O (+ (step-2-1-5 inserted-between))
     (- (step-2-1 $x))))

(exec (2)
  (, (step-2-1-5 $x))
  (O (+ (step-2-2 after-2))
     (- (step-2-1-5 $x))))

; Expected order: (1) < (1 5) < (2)
; State: start → after-1 → inserted-between → after-2

; ============================================================================
; LEVEL 3: Fractal subdivision - insert between (1) and (1 5)!
; ============================================================================

(step-3-0 start)

(exec (1)
  (, (step-3-0 $x))
  (O (+ (step-3-1 after-1))
     (- (step-3-0 $x))))

; INSERT: Between (1) and (1 5) using (1 2 5)
; Tuple comparison: (1) < (1 2 5) < (1 5)
(exec (1 2 5)
  (, (step-3-1 $x))
  (O (+ (step-3-1-25 inserted-1-25))
     (- (step-3-1 $x))))

(exec (1 5)
  (, (step-3-1-25 $x))
  (O (+ (step-3-1-5 after-1-5))
     (- (step-3-1-25 $x))))

(exec (2)
  (, (step-3-1-5 $x))
  (O (+ (step-3-2 after-2))
     (- (step-3-1-5 $x))))

; Expected order: (1) < (1 2 5) < (1 5) < (2)
; State: start → after-1 → inserted-1-25 → after-1-5 → after-2

; ============================================================================
; SUMMARY: Sierpiński Triangle of Priorities
; ============================================================================
;
; Pattern for infinite subdivision:
;
; Level 0:  (1) ─────────────────── (2)
;
; Level 1:  (1) ──── (1 5) ──────── (2)
;
; Level 2:  (1) ─ (1 2 5) ─ (1 5) ─ (1 7 5) ─ (2)
;
; Level 3:  (1) (1 1 2 5) (1 2 5) (1 3 7 5) (1 5) (1 6 2 5) (1 7 5) (1 8 7 5) (2)
;
; Algorithm to insert between (A) and (B):
;   - If B is single element: insert (A mid(A,B))
;     Example: between (1) and (2), insert (1 5) where 5 = (1+9)/2
;
;   - If B is tuple starting with A's value: prepend to B
;     Example: between (1) and (1 5), insert (1 2 5)
;     Example: between (1 2 5) and (1 5), insert (1 2 5 7 5)
;
;   - Works infinitely because tuples can grow arbitrarily!
;
; This is EXACTLY like a Sierpiński triangle:
;   - Start with two points
;   - Insert midpoint
;   - Recursively subdivide each segment
;   - Infinite detail at all scales!
