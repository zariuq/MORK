; Linked List Priorities - Using nested tuples for infinite subdivision
; ======================================================================
; Pattern: Use (n (0)) where (0) acts as terminator, insert (n (m (0))) between
; Examples:
;   (1 (0)) represents priority [1]
;   (2 (0)) represents priority [2]
;   (1 (5 (0))) inserted between (1 (0)) and (2 (0))
;   (1 (2 (5 (0)))) inserted between (1 (0)) and (1 (5 (0)))
;
; Key insight: Can ALWAYS insert between priorities by nesting deeper
; Between (1 (0)) and (2 (0)), insert (1 (5 (0)))

; === Initial tasks with nested tuple priorities ===
(task (1 (0)) setup)
(task (2 (0)) test)

; === Execution order tracking ===
(exec-order 0)
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6)

; === Dynamic insertion trigger ===
(insert-task implement)

(step (0 insert)
  (, (insert-task $name))
  (O (+ (task (1 (5 (0))) $name))
     (- (insert-task $name))))

; === Further subdivision trigger ===
(insert-task-before implement design)

; Driver: Insert design before implement by extending the nesting
(step (0 insert-before)
  (, (insert-task-before $target $new_name)
     (task (1 (5 (0))) $target))
  (O (+ (task (1 (2 (5 (0)))) $new_name))
     (- (insert-task-before $target $new_name))))

; === Run triggers for all tasks ===
(run setup)
(run implement)
(run design)
(run test)

; === Task activation: Convert tasks to execs with nested tuple priorities ===
; Each exec will track when it runs using the exec-order counter
(step (1 activate)
  (, (task $priority $name))
  (O (+ (exec ($priority $name)
          (, (run $name) (exec-order $n) (S $n $next))
          (O (+ (executed-at $n $priority $name))
             (- (run $name))
             (- (exec-order $n))
             (+ (exec-order $next)))))
     (- (task $priority $name))))

(exec (99 bootstrap)
  (, (step ($priority $name) $premises $conclusions)
     (exec (99 bootstrap) $p $t))
  (O (+ (exec ($priority $name) $premises $conclusions))
     (+ (exec (99 bootstrap) $p $t))))

; Actual execution order:
; (executed-at 0 (1 (0)) setup)             - First
; (executed-at 1 (1 (2 (5 (0)))) design)    - Second
; (executed-at 2 (1 (5 (0))) implement)     - Third
; (executed-at 3 (2 (0)) test)              - Last
;
; This demonstrates:
; 1. Clean syntax - (n (0)) as base, (n (m (0))) for subdivision
; 2. Can insert infinitely by nesting deeper between any two priorities
; 3. Dynamic insertion creates tasks with intermediate priorities
; 4. Works like linked lists for infinite priority subdivision!

