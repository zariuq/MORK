; Linked List Priorities - Using nested tuples instead of Cons/Nil
; ==================================================================
; Instead of (Cons 1 Nil), (Cons 1 (Cons 5 Nil)), etc
; Use: (1 0), (1 (5 0)), (1 (5 (7 0))), etc
;
; Pattern: (head tail) where tail is either 0 or another nested tuple
; Examples:
;   (0 0) represents [0]
;   (1 0) represents [1]
;   (0 (0 0)) represents [0, 0]
;   (1 (2 (3 0))) represents [1, 2, 3]
;
; Key insight: Can ALWAYS insert between priorities by extending the list
; Between (1 0) and (2 0), insert (1 (5 0))

; === Initial tasks with nested tuple priorities ===
(task (1 0) setup)
(task (2 0) test)

; === Execution order tracking ===
(exec-order 0)
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6)

; === Dynamic insertion trigger ===
(insert-task implement)

(step (0 insert)
  (, (insert-task $name))
  (O (+ (task (1 (5 0)) $name))
     (- (insert-task $name))))

; === Further subdivision trigger ===
(insert-task-before implement design)

; Driver: Insert design before implement by extending the list
(step (0 insert-before)
  (, (insert-task-before $target $new_name)
     (task (1 (5 0)) $target))
  (O (+ (task (1 (2 (5 0))) $new_name))
     (- (insert-task-before $target $new_name))))

; === Run triggers for all tasks ===
(run setup)
(run implement)
(run design)
(run test)

; === Task activation: Convert tasks to execs with nested tuple priorities ===
; Each exec will track when it runs using the exec-order counter
(step (1 activate)
  (, (task $priority $name))
  (O (+ (exec ($priority $name)
          (, (run $name) (exec-order $n) (S $n $next))
          (O (+ (executed-at $n $priority $name))
             (- (run $name))
             (- (exec-order $n))
             (+ (exec-order $next)))))
     (- (task $priority $name))))

(exec (99 bootstrap)
  (, (step ($priority $name) $premises $conclusions)
     (exec (99 bootstrap) $p $t))
  (O (+ (exec ($priority $name) $premises $conclusions))
     (+ (exec (99 bootstrap) $p $t))))

; Expected execution order (if () comes before 0):
; (executed-at 0 (1 (2 (5 0))) design)       - First (deepest nesting)
; (executed-at 1 (1 (5 0)) implement)        - Second
; (executed-at 2 (1 0) setup)                - Third
; (executed-at 3 (2 0) test)                 - Last
;
; This demonstrates:
; 1. No Cons/Nil clutter - just nested tuples
; 2. Can insert infinitely: just extend the nesting
; 3. Dynamic insertion rules create tasks with computed priorities
; 4. The exec priorities ARE the nested tuples themselves!

