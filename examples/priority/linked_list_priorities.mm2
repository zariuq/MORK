; Linked List Priorities - Infinite Subdivision Without Hardcoding
; =================================================================
; Instead of tuple priorities like (1), (1 5), (1 2 5)
; Use cons list priorities: (Cons 1 Nil), (Cons 1 (Cons 5 Nil))
;
; Key insight: Can ALWAYS insert between any two priorities by extending the list
; Example: Between (Cons 1 Nil) and (Cons 2 Nil)
;          Insert (Cons 1 (Cons 5 Nil))
;
; This demonstrates truly dynamic priority creation!

; === Initial tasks with cons list priorities ===
(task (Cons 1 Nil) setup)
(task (Cons 2 Nil) test)

; === Execution order tracking ===
(exec-order 0)
(S 0 1) (S 1 2) (S 2 3) (S 3 4) (S 4 5) (S 5 6)

; === Dynamic insertion trigger ===
(insert-task implement)

(step (0 insert)
  (, (insert-task $name))
  (O (+ (task (Cons 1 (Cons 5 Nil)) $name))
     (- (insert-task $name))))

; === Further subdivision trigger ===
(insert-task-before implement design)

; Driver: Insert design before implement by extending the list
(step (0 insert-before)
  (, (insert-task-before $target $new_name)
     (task (Cons 1 (Cons 5 Nil)) $target))
  (O (+ (task (Cons 1 (Cons 2 (Cons 5 Nil))) $new_name))
     (- (insert-task-before $target $new_name))))

; === Run triggers for all tasks ===
(run setup)
(run implement)
(run design)
(run test)

; === Task activation: Convert tasks to execs with cons list priorities ===
; Each exec will track when it runs using the exec-order counter
(step (1 activate)
  (, (task $priority $name))
  (O (+ (exec ($priority $name)
          (, (run $name) (exec-order $n) (S $n $next))
          (O (+ (executed-at $n $priority $name))
             (- (run $name))
             (- (exec-order $n))
             (+ (exec-order $next)))))
     (- (task $priority $name))))

(exec (99 bootstrap)
  (, (step ($priority $name) $premises $conclusions)
     (exec (99 bootstrap) $p $t))
  (O (+ (exec ($priority $name) $premises $conclusions))
     (+ (exec (99 bootstrap) $p $t))))

; Actual execution results with order tracking (verified):
; (executed-at 0 (Cons 1 (Cons 2 (Cons 5 Nil))) design)       - First (step 0)
; (executed-at 1 (Cons 1 (Cons 5 Nil)) implement)             - Second (step 1)
; (executed-at 2 (Cons 1 Nil) setup)                          - Third (step 2)
; (executed-at 3 (Cons 2 Nil) test)                           - Last (step 3)
; Final state: (exec-order 4) - all 4 tasks completed
;
; Note: The execution order shows that MORK processes deeper cons lists first:
;   (Cons 1 (Cons 2 (Cons 5 Nil))) executes before (Cons 1 (Cons 5 Nil))
;   (Cons 1 (Cons 5 Nil)) executes before (Cons 1 Nil)
; This suggests longer/deeper lists have higher priority in MORK's ordering.
;
; Beautiful properties:
; 1. No hardcoded priorities beyond the base (Cons 1 Nil) and (Cons 2 Nil)
; 2. Can insert infinitely: just extend the cons list
; 3. Dynamic insertion rules create tasks with computed priorities
; 4. The exec priorities ARE the cons lists themselves!
; 5. Execution order is tracked with (exec-order N) counter
;
; This is the "infinite subdivision" pattern with actual cons lists!
