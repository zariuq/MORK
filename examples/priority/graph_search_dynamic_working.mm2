; Dynamic Priority Graph Search - Working Implementation
; ======================================================
; BFS, DFS, and Best-First search controlled by computed priorities
; Uses numeric step counter instead of successor notation

; ---------- Graph Structure ----------
; Goal hidden at depth 4 on left branch
; Good heuristics mislead best-first to explore right side deeply
; BFS finds goal faster by systematic breadth-first exploration
;
;              start
;          /     |      \
;        a1     a2      a3 (h=1, looks promising!)
;       /|\    /|\      /|\
;      b1 b2  b3 b4   b5 b6 b7 (b5 h=1, very promising!)
;     /|\ |   |  |    /|\ |
;    c1 c2   c3 c4   c5 c6 c7 (c5 h=0, looks like goal!)
;    |  |    |  |    |  |  |
;   d1 d2   d3 d4   d5 d6 d7 (d5 is dead end!)
;   |
; GOAL (actually on left at d1!)

(edge start a1) (edge start a2) (edge start a3)

(edge a1 b1) (edge a1 b2) (edge a1 b3)
(edge a2 b4) (edge a2 b5) (edge a2 b6)
(edge a3 b7) (edge a3 b8) (edge a3 b9)

(edge b1 c1) (edge b1 c2) (edge b1 c3)
(edge b2 c4) (edge b2 c5) (edge b2 c6)
(edge b3 c7) (edge b3 c8) (edge b3 c9)
(edge b4 c10) (edge b4 c11) (edge b4 c12)
(edge b5 c13) (edge b5 c14) (edge b5 c15)
(edge b6 c16)
(edge b7 c17)

(edge c1 d1) (edge c1 d2) (edge c1 d3)
(edge c2 d4) (edge c2 d5) (edge c2 d6)
(edge c3 d7)
(edge c4 d8)
(edge c13 d9) (edge c13 d10) (edge c13 d11)
(edge c14 d12)
(edge c15 d13)

(edge d1 e1)

; ---------- Heuristic to goal (OPTIMAL PATH) ----------
; Goal is c5. Optimal path: start -> a1 -> b2 -> c5
(h start 3)
(h a1 2) (h a2 99) (h a3 99)
(h b1 99) (h b2 1) (h b3 99) (h b4 99) (h b5 99) (h b6 99) (h b7 99) (h b8 99) (h b9 99)
(h c1 99) (h c2 99) (h c3 99) (h c4 99) (h c5 0) (h c6 99)
(h c7 99) (h c8 99) (h c9 99) (h c10 99) (h c11 99) (h c12 99)
(h c13 99) (h c14 99) (h c15 99)
(h c16 99) (h c17 99)
(h d1 99) (h d2 99) (h d3 99) (h d4 99) (h d5 99) (h d6 99) (h d7 99) (h d8 99)
(h d9 99) (h d10 99) (h d11 99) (h d12 99) (h d13 99)
(h e1 99)

; ---------- Configuration ----------
(start start)
(goal c5)
; (strategy bfs)   ; Explores all nodes at each depth before going deeper
(strategy best)    ; Follows lowest heuristic - can be misled!

; ---------- Priority Computation ----------
; BFS: priority = depth (process shallow first)
(compute-prio bfs depth $d heur $h result $d)


; Best-First: priority = heuristic (process low h first)
(compute-prio best depth $d heur $h result $h)

; ---------- Increment Rules ----------
(inc 0 1) (inc 1 2) (inc 2 3) (inc 3 4) (inc 4 5) (inc 5 6) (inc 6 7) (inc 7 8) (inc 8 9) (inc 9 10)
(inc 10 11) (inc 11 12) (inc 12 13) (inc 13 14) (inc 14 15) (inc 15 16) (inc 16 17) (inc 17 18) (inc 18 19) (inc 19 20)
(inc 20 21) (inc 21 22) (inc 22 23) (inc 23 24) (inc 24 25) (inc 25 26) (inc 26 27) (inc 27 28) (inc 28 29) (inc 29 30)
(inc 30 31) (inc 31 32) (inc 32 33) (inc 33 34) (inc 34 35) (inc 35 36) (inc 36 37) (inc 37 38) (inc 38 39) (inc 39 40)
(inc 40 41) (inc 41 42) (inc 42 43) (inc 43 44) (inc 44 45) (inc 45 46) (inc 46 47) (inc 47 48) (inc 48 49) (inc 49 50)
(inc 50 51) (inc 51 52) (inc 52 53) (inc 53 54) (inc 54 55) (inc 55 56) (inc 56 57) (inc 57 58) (inc 58 59) (inc 59 60)
(inc 60 61) (inc 61 62) (inc 62 63) (inc 63 64) (inc 64 65) (inc 65 66) (inc 66 67) (inc 67 68) (inc 68 69) (inc 69 70)

; ---------- Step Counter ----------
(step-count 0)

; ---------- Step 0: Seed Initial Node ----------
(step (0 seed)
  (, (start $s) (h $s $hs) (strategy $strat) (compute-prio $strat depth 0 heur $hs result $prio))
  (O (+ (task $prio node $s depth 0))
     (- (start $s))))

; ---------- Step 1: Activate Task (Create Expansion Exec) ----------
(step (1 activate)
  (, (task $prio node $node depth $depth))
  (O (+ (exec ($prio (expand $node $depth))
          (, (unseen $node) (h $node $hnode) (step-count $sc) (inc $sc $next))
          (O (+ (visited $sc $node depth $depth h $hnode))
             (+ (mark-expanded $node $depth))
             (- (unseen $node))
             (+ (step-count $next))
             (- (step-count $sc)))))
     (- (task $prio node $node depth $depth))))

; ---------- Step 2: Spawn Child Tasks ----------
(step (2 spawn)
  (, (mark-expanded $parent $pdepth)
     (edge $parent $child)
     (unseen $child)
     (h $child $hchild)
     (inc $pdepth $cdepth)
     (strategy $strat)
     (compute-prio $strat depth $cdepth heur $hchild result $cprio))
  (O (+ (task $cprio node $child depth $cdepth))
     (- (mark-expanded $parent $pdepth))))

; ---------- Goal Detection ----------
(step (3 goal-check)
  (, (goal $g) (visited $seq $g depth $depth h $hg) (exec $priority $match $template))
  (O (+ (solution found $g at-step $seq depth $depth))
     (- (exec $priority $match $template))))

; ---------- Initial State ----------
(unseen start) (unseen a1) (unseen a2) (unseen a3)
(unseen b1) (unseen b2) (unseen b3) (unseen b4) (unseen b5) (unseen b6) (unseen b7) (unseen b8) (unseen b9)
(unseen c1) (unseen c2) (unseen c3) (unseen c4) (unseen c5) (unseen c6) (unseen c7) (unseen c8) (unseen c9)
(unseen c10) (unseen c11) (unseen c12) (unseen c13) (unseen c14) (unseen c15) (unseen c16) (unseen c17)
(unseen d1) (unseen d2) (unseen d3) (unseen d4) (unseen d5) (unseen d6) (unseen d7) (unseen d8)
(unseen d9) (unseen d10) (unseen d11) (unseen d12) (unseen d13)
(unseen goal)

; ---------- Bootstrap: Activate step rules ----------
(exec bc
  (, (step ($priority $name) $premises $conclusions)
     (exec bc $p $c))
  (O (+ (exec ($priority $name) $premises $conclusions))
     (+ (exec bc $p $c))))

; ---------- Expected Results ----------
; With (strategy bfs):
;   Systematically explores depth 0, 1, 2, 3, then finds goal at depth 4
;   Visits ~40 nodes before finding goal

;
; With (strategy best):
;   Follows misleading heuristics: a3 (h=2) -> b5 (h=1) -> c13 (h=0, looks like goal!)
;   Then backtracks when c13 is dead end or wrong
;   Explores many promising-looking nodes before finding actual goal
;   Should visit 50+ nodes due to misleading heuristics!
;
; This graph demonstrates: Good heuristics help, but bad heuristics hurt!
; BFS's simplicity wins when heuristics are unreliable.

