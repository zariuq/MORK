(exec (1 (5 (0)))
  (, (dummy) (exec-order $n) (S $n $next))
  (O (+ (result test7))
     (+ (executed-at $n (1 (5 (0))) test7))
     (- (exec-order $n))
     (+ (exec-order $next))))

(exec (1 (0))
  (, (dummy) (exec-order $n) (S $n $next))
  (O (+ (result test1))
     (+ (executed-at $n (1 (0)) test8))
     (- (exec-order $n))
     (+ (exec-order $next))))

(exec ((2 (0)))
  (, (dummy) (exec-order $n) (S $n $next))
  (O (+ (result test2))
     (+ (executed-at $n ((2 (0))) test9))
     (- (exec-order $n))
     (+ (exec-order $next))))

(exec (2 (0))
