; Hexlife Loop e06 - Hybrid (Axial + Peano) - Fixed
; Matches (neighbor q r nq nr) arity.

(cell lives 2)

; === 0. Definitions ===
(peano 0 Z)
(peano 1 (S Z))
(peano 2 (S (S Z)))
(peano 3 (S (S (S Z))))
(peano 4 (S (S (S (S Z)))))
(peano -1 (P Z))
(peano -2 (P (P Z)))
(peano -3 (P (P (P Z))))

; === 1. Simulation Logic ===
(rule 0 (, (alive $q $r) (neighbor $q $r $nq $nr))
        (O (count (anbs $nq $nr $k) $k ($q $r))))

(rule 1 (, (alive $q $r)) (O (- (alive $q $r))))
(rule 2 (, (anbs $q $r $c) (cell lives $c)) (O (+ (alive $q $r))))
(rule 3 (, (anbs $q $r $c)) (O (- (anbs $q $r $c))))

; === 2. Setup ===
(step 0) (step 1) (step 2) (step 3) (step 4)
; (step 5) (step 6) (step 7) (step 8) (step 9)

(input-alive 2 1)
(input-alive 1 2)
(input-alive 1 3)

; === 3. Execution Pipeline ===
(exec (1 (0))
      (, (input-alive $q $r) (peano $q $pq) (peano $r $pr))
      (O (+ (alive $pq $pr)) (- (input-alive $q $r))))

(exec (2 (0))
      (, (step $s)
         (rule $phase $lhs $rhs))
      (, (exec (3 ($s ($phase (0)))) $lhs $rhs)))

(exec (4 (0))
      (, (alive $pq $pr) (peano $q $pq) (peano $r $pr))
      (O (+ (output-alive $q $r))))

; === 4. Neighbor Logic ===(neighbor (P $q) $r $q $r)
(neighbor Z $r (S Z) $r)
(neighbor (S $q) $r (S (S $q)) $r)
(neighbor (P $q) (S $r) $q $r)
(neighbor (P $q) Z $q (P Z))
(neighbor (P $q) (P $r) $q (P (P $r)))
(neighbor Z (S $r) (S Z) $r)
(neighbor Z Z (S Z) (P Z))
(neighbor Z (P $r) (S Z) (P (P $r)))
(neighbor (S $q) (S $r) (S (S $q)) $r)
(neighbor (S $q) Z (S (S $q)) (P Z))
(neighbor (S $q) (P $r) (S (S $q)) (P (P $r)))
(neighbor $q (S $r) $q $r)
(neighbor $q Z $q (P Z))
(neighbor $q (P $r) $q (P (P $r)))
(neighbor (S $q) $r $q $r)
(neighbor Z $r (P Z) $r)
(neighbor (P $q) $r (P (P $q)) $r)
(neighbor (S $q) (P $r) $q $r)
(neighbor (S $q) Z $q (S Z))
(neighbor (S $q) (S $r) $q (S (S $r)))
(neighbor Z (P $r) (P Z) $r)
(neighbor Z Z (P Z) (S Z))
(neighbor Z (S $r) (P Z) (S (S $r)))
(neighbor (P $q) (P $r) (P (P $q)) $r)
(neighbor (P $q) Z (P (P $q)) (S Z))
(neighbor (P $q) (S $r) (P (P $q)) (S (S $r)))
(neighbor $q (P $r) $q $r)
(neighbor $q Z $q (S Z))
(neighbor $q (S $r) $q (S (S $r)))
