; Hexlife Loop e03 - Shifted Test (Negative Coordinates)
; Tests the "Edge of the Universe" logic by centering the oscillator around 0.

; === 0. Definitions ===

; Integer Peano (For Coordinates)
(peano 0 Z)
(peano 1 (S Z))
(peano 2 (S (S Z)))
(peano 3 (S (S (S Z))))
(peano 4 (S (S (S (S Z)))))
(peano -1 (P Z))
(peano -2 (P (P Z)))
(peano -3 (P (P (P Z))))

; Priority Peano (For Sorting - Remains Positive)
(prio 0 (A))
(prio 1 (S (A)))
(prio 2 (S (S (A))))
(prio 3 (S (S (S (A)))))
(prio 4 (S (S (S (S (A))))))

(cell lives 2)

; Simulation Rules (Phase A-D)
(rule A
      (, (alive $co) (neighbors $co $nco) (alive $nco))
      (O (count (anbs $co $k) $k $nco)))
(rule A
      (, (alive $co) (neighbors $co $nco) (neighbors $nco $nnco) (alive $nnco))
      (O (count (anbs $nco $k) $k $nnco)))

(rule B (, (alive $co)) (O (- (alive $co))))
(rule C (, (anbs $co $c) (cell lives $c)) (O (+ (alive $co))))
(rule D (, (anbs $co $c)) (O (- (anbs $co $c))))


; === 1. Setup Data ===

(step 0) (step 1) (step 2) (step 3) (step 4)

; Input Data (Shifted by -2)
; Original: (2 1 1) -> (0 -1 -1)
; Original: (1 2 1) -> (-1 0 -1)
; Original: (1 3 0) -> (-1 1 -2)

(input-alive (0 -1 -1))
(input-alive (-1 0 -1))
(input-alive (-1 1 -2))


; === 2. Execution Phases ===

; Priority (1 (0)): Import
(exec (1 (0))
      (, (input-alive ($q $r $s)) 
         (peano $q $pq) 
         (peano $r $pr) 
         (peano $s $ps))
      (O (+ (alive ($pq $pr $ps))) 
         (- (input-alive ($q $r $s)))))

; Priority (2 (0)): Generator
(exec (2 (0))
      (, (step $s)
         (prio $s $p_step)
         (rule $p_phase $lhs $rhs))
      (, (exec (3 ($p_step ($p_phase (0)))) $lhs $rhs)))

; Priority (4 (0)): Export
(exec (4 (0))
      (, (alive ($pq $pr $ps))
         (peano $q $pq)
         (peano $r $pr)
         (peano $s $ps))
      (O (+ (output-alive ($q $r $s)))))


; === 3. Neighbor Logic (54 Rules) ===
(neighbors ((P $q) $r (S $s)) ($q $r $s))
(neighbors ((P $q) $r Z) ($q $r (P Z)))
(neighbors ((P $q) $r (P $s)) ($q $r (P (P $s))))
(neighbors (Z $r (S $s)) ((S Z) $r $s))
(neighbors (Z $r Z) ((S Z) $r (P Z)))
(neighbors (Z $r (P $s)) ((S Z) $r (P (P $s))))
(neighbors ((S $q) $r (S $s)) ((S (S $q)) $r $s))
(neighbors ((S $q) $r Z) ((S (S $q)) $r (P Z)))
(neighbors ((S $q) $r (P $s)) ((S (S $q)) $r (P (P $s))))
(neighbors ((P $q) (S $r) $s) ($q $r $s))
(neighbors ((P $q) Z $s) ($q (P Z) $s))
(neighbors ((P $q) (P $r) $s) ($q (P (P $r)) $s))
(neighbors (Z (S $r) $s) ((S Z) $r $s))
(neighbors (Z Z $s) ((S Z) (P Z) $s))
(neighbors (Z (P $r) $s) ((S Z) (P (P $r)) $s))
(neighbors ((S $q) (S $r) $s) ((S (S $q)) $r $s))
(neighbors ((S $q) Z $s) ((S (S $q)) (P Z) $s))
(neighbors ((S $q) (P $r) $s) ((S (S $q)) (P (P $r)) $s))
(neighbors ($q (S $r) (P $s)) ($q $r $s))
(neighbors ($q (S $r) Z) ($q $r (S Z)))
(neighbors ($q (S $r) (S $s)) ($q $r (S (S $s))))
(neighbors ($q Z (P $s)) ($q (P Z) $s))
(neighbors ($q Z Z) ($q (P Z) (S Z)))
(neighbors ($q Z (S $s)) ($q (P Z) (S (S $s))))
(neighbors ($q (P $r) (P $s)) ($q (P (P $r)) $s))
(neighbors ($q (P $r) Z) ($q (P (P $r)) (S Z)))
(neighbors ($q (P $r) (S $s)) ($q (P (P $r)) (S (S $s))))
(neighbors ((S $q) $r (P $s)) ($q $r $s))
(neighbors ((S $q) $r Z) ($q $r (S Z)))
(neighbors ((S $q) $r (S $s)) ($q $r (S (S $s))))
(neighbors (Z $r (P $s)) ((P Z) $r $s))
(neighbors (Z $r Z) ((P Z) $r (S Z)))
(neighbors (Z $r (S $s)) ((P Z) $r (S (S $s))))
(neighbors ((P $q) $r (P $s)) ((P (P $q)) $r $s))
(neighbors ((P $q) $r Z) ((P (P $q)) $r (S Z)))
(neighbors ((P $q) $r (S $s)) ((P (P $q)) $r (S (S $s))))
(neighbors ((S $q) (P $r) $s) ($q $r $s))
(neighbors ((S $q) Z $s) ($q (S Z) $s))
(neighbors ((S $q) (S $r) $s) ($q (S (S $r)) $s))
(neighbors (Z (P $r) $s) ((P Z) $r $s))
(neighbors (Z Z $s) ((P Z) (S Z) $s))
(neighbors (Z (S $r) $s) ((P Z) (S (S $r)) $s))
(neighbors ((P $q) (P $r) $s) ((P (P $q)) $r $s))
(neighbors ((P $q) Z $s) ((P (P $q)) (S Z) $s))
(neighbors ((P $q) (S $r) $s) ((P (P $q)) (S (S $r)) $s))
(neighbors ($q (P $r) (S $s)) ($q $r $s))
(neighbors ($q (P $r) Z) ($q $r (P Z)))
(neighbors ($q (P $r) (P $s)) ($q $r (P (P $s))))
(neighbors ($q Z (S $s)) ($q (S Z) $s))
(neighbors ($q Z Z) ($q (S Z) (P Z)))
(neighbors ($q Z (P $s)) ($q (S Z) (P (P $s))))
(neighbors ($q (S $r) (S $s)) ($q (S (S $r)) $s))
(neighbors ($q (S $r) Z) ($q (S (S $r)) (P Z)))
(neighbors ($q (S $r) (P $s)) ($q (S (S $r)) (P (P $s))))
