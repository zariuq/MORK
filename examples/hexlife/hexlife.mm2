; Hexlife - A variant of Conway's Game of Life on a hexagonal grid
; From literature/MORK.wiki/MM2-tutorial:-Hexlife.md

; Initial Grid
; Alive cells: (2, 1, 1), (1, 2, 1), (1, 3, 0)
(alive ((S (S Z)) (S Z) (S Z)))
(alive ((S Z) (S (S Z)) (S Z)))
(alive ((S Z) (S (S (S Z))) Z))

; Neighbor definitions (Cube coordinates)
(neighbors ($q $r (S $s)) ($q (S $r) $s))
(neighbors ($q $r (S $s)) ((S $q) $r $s))
(neighbors ($q (S $r) $s) ((S $q) $r $s))
(neighbors ($q (S $r) $s) ($q $r (S $s)))
(neighbors ((S $q) $r $s) ($q (S $r) $s))
(neighbors ((S $q) $r $s) ($q $r (S $s)))

; Rule: A cell lives if it has exactly 2 neighbors
(cell lives 2)

; One evolution step

; 1. Count alive neighbors for alive cells
(exec 0 (, (alive $co) (neighbors $co $nco) (alive $nco))
        (O (count (anbs $co $k) $k $nco)))

; 2. Count alive neighbors for neighbors of alive cells (potentially dead cells)
(exec 0 (, (alive $co) (neighbors $co $nco) (neighbors $nco $nnco) (alive $nnco))
        (O (count (anbs $nco $k) $k $nnco)))

; 3. Remove all currently alive cells (to be re-added if they survive)
(exec 1 (, (alive $co)) (O (- (alive $co))))

; 4. Mark cells as alive if they have the correct neighbor count (2)
(exec 2 (, (anbs $co $c) (cell lives $c)) (O (+ (alive $co))))

; 5. Clean up neighbor counts for the next step
(exec 3 (, (anbs $co $c)) (O (- (anbs $co $c))))
