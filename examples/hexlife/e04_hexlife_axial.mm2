; Hexlife Loop e05 - Clean Standard
; - Axial Coordinates (Integers)
; - Linked-List Priorities (3 (Step (Phase (0)))) using Integers directly.
; - No Peano, No Logic Mappings. Pure and simple.

(cell lives 2)

; === 1. Simulation Logic ===

; Phase 0: Count Neighbors
(rule 0 (, (alive $q $r) (neighbor $q $r $nq $nr))
        (O (count (anbs $nq $nr $k) $k ($q $r))))

; Phase 1: Remove Old State
(rule 1 (, (alive $q $r)) (O (- (alive $q $r))))

; Phase 2: Apply Rules (Birth/Survival)
(rule 2 (, (anbs $q $r $c) (cell lives $c)) (O (+ (alive $q $r))))

; Phase 3: Cleanup Counters
(rule 3 (, (anbs $q $r $c)) (O (- (anbs $q $r $c))))


; === 2. Setup ===
(step 0) (step 1) (step 2) (step 3) (step 4)

; Initial State (Axial q, r)
(input-alive 2 1)
(input-alive 1 2)
(input-alive 1 3)


; === 3. Execution Pipeline ===

; Priority 1.0: Import
(exec (1 (0))
      (, (input-alive $q $r))
      (O (+ (alive $q $r)) (- (input-alive $q $r))))

; Priority 2.0: Generator
; Expands (step $s) into sequential executions for phases 0-3.
; Priority: 3.Step.Phase
(exec (2 (0))
      (, (step $s)
         (rule $phase $lhs $rhs))
      (, (exec (3 ($s ($phase (0)))) $lhs $rhs)))

; Priority 4.0: Export
(exec (4 (0))
      (, (alive $q $r))
      (O (+ (output-alive $q $r))))


