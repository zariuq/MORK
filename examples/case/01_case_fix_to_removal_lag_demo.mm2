; Side-by-side: OLD pattern (removal lag) vs CASE pattern
; =======================================================

; === PART 1: Demonstrate the BUG (removal lag) ===

; (state-old ready)

; ; Step 1: Create trigger
; (exec 10
;   (, (state-old ready))
;   (O (- (state-old ready))
;      (+ (trigger-old "x"))))

; ; Step 2a: Check for error, remove trigger
; (exec 11
;   (, (trigger-old "x"))
;   (O (+ (error-old "x"))
;      (- (trigger-old "x"))))

; ; Step 2b: Add success (BUG: fires even though 11 removes trigger!)
; (exec 12
;   (, (trigger-old "x"))
;   (O (+ (add-old "x"))))


; === PART 2: CASE pattern (fixes the bug) ===

(S 0 1) (S 1 2) (S 2 3)
(exec-order 0)
(state-new ready)
(constant "x")  ; Pre-existing constant - should trigger error

; Step 1: Create trigger
(exec (20 (0 (0)))
  (, (state-new ready) (exec-order $n) (S $n $next))
  (O (- (state-new ready))
     (+ (trigger-new "x"))
     (- (exec-order $n))
     (+ (exec-order $next))))

; Step 2: Snapshot - create alternatives
(exec (21 (0 (0)))
  (, (trigger-new $x) (exec-order $n) (S $n $next))
  (O (+ (alt-error-new $x))
     (+ (alt-add-new $x))
     (- (trigger-new $x))
     (- (exec-order $n))
     (+ (exec-order $next))))

; Step 3a: Error path - fires if constant exists, removes other alternative
(exec (22 (0 (0)))
  (, (alt-error-new $x) (constant $x) (exec-order $n) (S $n $next))
  (O (+ (error-new $x))
     (- (alt-error-new $x))
     (- (alt-add-new $x))  ; KEY: This prevents 3b from firing!
     (- (exec-order $n))
     (+ (exec-order $next))))

; Step 3b: Success path - only fires if both alternatives still exist
(exec (22 (1 (0)))
  (, (alt-add-new $x) (alt-error-new $x) (exec-order $n) (S $n $next))
  (O (+ (add-new $x))
     (- (alt-add-new $x))
     (- (alt-error-new $x))
     (- (exec-order $n))
     (+ (exec-order $next))))

; Expected:
; OLD pattern: (error-old "x") AND (add-old "x") - BOTH fire (BUG)
; NEW pattern: (error-new "x") ONLY - success prevented (FIXED)
